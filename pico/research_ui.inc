void research_formula(unsigned which){char text[160];strcpy(text,research->formula[which]);static const char *const title[]={"Implicit equation / field F(X,Y)","Objective F(X,Y)","Calculus F(X)","Uncertainty F(A,B,C)"};if(formula_entry(title[which],text,false,false,false,which==0?"Enter left=right, or F(X,Y) for contour levels":"Angles are radians; viewing preserves calculator variables")){pico_research_evaluator check(text,which==0);if(!check.valid()){engine_error();return;}strcpy(research->formula[which],text);research->dirty=true;}}
void research_bounds(double *v,const char *title){double next[4];memcpy(next,v,32);const char *names[]={"Minimum X","Maximum X","Minimum Y","Maximum Y"};for(unsigned i=0;i<4;++i)if(!analysis_number(names[i],next[i]))return;if(!pico_plot_engine::bounds(next)){notice(title,"Use finite, increasing bounds on both axes.");return;}memcpy(v,next,32);research->dirty=true;}
bool research_result_text(char *out,size_t capacity,const char *context,const double *v,unsigned n,const char *const *units=nullptr){
 if(!n||n>8||capacity<32)return false;size_t used=0;
 auto append=[&](const char *format,auto... args){if(used>=capacity)return false;int count=snprintf(out+used,capacity-used,format,args...);if(count<0||size_t(count)>=capacity-used)return false;used+=size_t(count);return true;};
 if(n>1&&!append("Values (copy order):\n"))return false;
 for(unsigned i=0;i<n;++i){if(!std::isfinite(v[i]))return false;if(n==1){if(!append("Value: %.12g %s\n",v[i],units?units[i]:""))return false;}else if(!append("%u: %.12g %s\n",i+1,v[i],units?units[i]:""))return false;}
 return append("\n%s",context);
}
void research_values(const char *title,const char *text,const double *v,unsigned n,const char *const *units=nullptr){char body[1600];if(!research_result_text(body,sizeof body,text,v,n,units)){notice("Result unavailable","The result exceeded its numerical or display range. Inputs are retained.");return;}advanced_values("research.result",title,body,v,n,units);}

void research_matrix_result(const pico_research::matrix &m,const char *title,const char *context){for(unsigned i=0;i<m.n;++i)for(unsigned j=0;j<m.n;++j)if(!std::isfinite(m.a[i][j])){notice("Matrix result unavailable","The result exceeded floating-point range. Inputs are retained.");return;}object_g value=array::build(m.n,m.n,[](size_t,size_t,size_t row,size_t col,void *p)->object_p{return hwdouble::make(static_cast<const pico_research::matrix *>(p)->a[row][col]);},const_cast<pico_research::matrix *>(&m));if(!value){engine_error();return;}while(screen_result("research.matrix_result",value,title,context,true,"Matrix A")){pico_document_access<pico_matrix_document> access(matrix_cache,matrix_doc);if(!matrix_doc){notice("Matrix unavailable","Not enough document memory.");continue;}if(matrix_doc->dirty&&!confirm("Replace unsaved matrix A?"))continue;if(!pico_matrix_import(value,*matrix_doc))engine_error();else{notice("Matrix A updated","The result is ready in Matrix workbench.");break;}}}
void research_plot_table(pico_data_table &d,const char *label){if(!d.rows||!d.valid()){notice("Plot unavailable","No complete finite result table is available; inputs are retained.");return;}science_plot(d,label);}
bool research_engine_poll(void *p){auto &e=*static_cast<pico_research_evaluator *>(p);return e.failed||e.cancelled||science_poll(nullptr);}
void research_implicit(){for(;;){const char *items[]={"Edit equation / field","Window","Contour levels (up to three)","Plot implicit / contours","Objective F(X,Y)","Optimization bounds / initial point","Find local min / max","Files / help"};int n=screen_menu("research.implicit","Implicit graphs / optimization",items,8);if(n<0)return;if(n==0)research_formula(0);if(n==1)research_bounds(research->window,"Graph window");if(n==2){double count=research->contour_count,levels[3];memcpy(levels,research->levels,sizeof levels);if(!analysis_number("Number of contour levels (1..3)",count))continue;if(count<1||count>3||count!=floor(count)){notice("Contour count","Choose 1, 2 or 3.");continue;}bool ok=true;for(unsigned i=0;i<unsigned(count);++i){char title[40];snprintf(title,sizeof title,"Residual / field level %u",i+1);if(!analysis_number(title,levels[i])){ok=false;break;}}if(ok){research->contour_count=count;memcpy(research->levels,levels,sizeof levels);research->dirty=true;}}
 if(n==3){pico_research_evaluator evaluator(research->formula[0],true);if(!evaluator.valid()){engine_error();continue;}std::unique_ptr<pico_contour_layer> layer(new(std::nothrow) pico_contour_layer{pico_research_evaluator::field,&evaluator,research->levels,research->contour_count});if(!layer||!layer->segments.good()){notice("Plot unavailable","Not enough bounded contour storage. Other documents are retained.");continue;}layer->halt=research_engine_poll;if(!pico_compute_network_begin()){notice("Calculation busy","Finish the network request before plotting contours.");continue;}auto r=plot_request();memcpy(r.window,research->window,32);for(unsigned i=0;i<3;++i){r.active[i]=i<research->contour_count;char formula[53];plot_label(formula,sizeof formula,research->formula[0]);snprintf(r.label[i],80,"%s | level %.8g",formula,research->levels[std::min(i,2u)]);}plot_source source{nullptr,nullptr};source.contour=layer.get();int result=plot_curves(r,source);pico_compute_network_end();if(memcmp(r.window,research->window,32)){memcpy(research->window,r.window,32);research->dirty=true;}if(result<0||evaluator.failed||evaluator.cancelled){if(rt.error())engine_error();else notice(result==-2?"Plot interrupted":"Plot unavailable",result==-3?"Contour complexity/evaluation limit reached. Use fewer levels or a smaller window; no partial plot is accepted.":"Sampling was interrupted or storage failed; study inputs are retained.");}}
 if(n==4)research_formula(1);if(n==5){research_bounds(research->bounds,"Optimization bounds");double x=research->point[0],y=research->point[1];if(analysis_number("Initial X",x)&&analysis_number("Initial Y",y)){research->point[0]=x;research->point[1]=y;research->dirty=true;}}
 if(n==6){const char *items[]={"Local minimum","Local maximum"};int action=screen_menu("research.optimize","Bounded optimization",items,2);if(action<0)continue;pico_workspace_lease memory(pico_workspace_owner::numeric,1024);if(!memory.data){notice("Calculation busy","Working memory or network activity is busy. Try again when it finishes.");continue;}pico_research_evaluator e(research->formula[1]);if(!e.valid()){engine_error();continue;}screen_page("research.busy","Optimizing within bounds",{{nullptr,nullptr,nullptr,nullptr,"Cancel"}});flush_display();auto r=pico_research::minimize(pico_research_evaluator::field,&e,research->bounds,research->point,action,research_engine_poll);memory.release();if(r.status!=1){if(rt.error())engine_error();else notice("Optimization stopped","Cancelled, invalid starting point or evaluation limit. Try another initial point or bounds.");continue;}char text[400];snprintf(text,sizeof text,"X: %.12g\nY: %.12g\nF: %.12g\n\nLocal box-constrained numerical %s. Step resolution reached; this does not establish a global optimum. Different initial points can give different answers.\n\nCopy: [X,Y,F].",r.x,r.y,r.value,action?"maximum":"minimum");double values[]={r.x,r.y,r.value};research_values("Local optimum",text,values,3);}
 if(n==7)research_files();
 }}
void research_linear(){for(;;){const char *items[]={"Import current matrix A","QR decomposition","Singular value decomposition","Pseudoinverse / rank / condition","Symmetric eigenvalues / vectors","Least squares using table B as b","Files / help"};int n=screen_menu("research.linear","Advanced linear algebra (1..6)",items,7);if(n<0)return;if(n==0){pico_document_access<pico_matrix_document> access(matrix_cache,matrix_doc);if(!matrix_doc){notice("Matrix unavailable","Open Matrix workbench first.");continue;}if(matrix_doc->rows!=matrix_doc->columns){notice("Square matrix required","This study supports square matrices up to 6 by 6. Existing augmented-system solving remains available separately.");continue;}pico_research::matrix next;next.n=matrix_doc->rows;pico_workbench_scope scope;bool ok=scope.entered;for(unsigned i=0;i<next.n&&ok;++i)for(unsigned j=0;j<next.n&&ok;++j)ok=pico_quantity_input(matrix_doc->cells[i][j],"",next.a[i][j],false);if(!ok){engine_error();continue;}if(confirm("Replace the study matrix with matrix A?")){research->matrix=next;research->dirty=true;}}
