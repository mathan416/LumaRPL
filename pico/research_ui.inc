// Use the shared buffer for codecs; no 8 KiB automatic save/load array.
bool research_save(const char *path){pico_workspace_lease memory(pico_workspace_owner::source,pico_research_document::bytes);if(!memory.data)return false;auto *bytes=static_cast<uint8_t *>(memory.data);bool ok=research&&research->encode(bytes)&&pico_resource_save(path,bytes,pico_research_document::bytes);if(ok)research->dirty=false;return ok;}
// Explicit implementation passes the lease to validation without a static alias.
bool research_read(const char *path,bool &backup){pico_workspace_lease memory(pico_workspace_owner::source,pico_research_document::bytes);if(!memory.data||!research)return false;auto *b=static_cast<uint8_t *>(memory.data);return pico_resource_load(path,b,pico_research_document::bytes,backup,[&](size_t n){return research->decode(b,n);});}
void research_help(unsigned mode){static const char *const ids[]={"research.overview","research.contour_help","research.linear_help","research.calculus_help","research.statistics_help","research.signal_help","research.document_help"};unsigned i=std::min(6u,mode);const char *text=pico_ui_help::tool_text(ids[i]);screen_text(ids[i],"Advanced studies help",text,strlen(text));}
void research_files(){for(;;){const char *items[]={"Save connected study","Open connected study","Name / notes","Help"};int n=screen_menu("research.files","Study files",items,4);if(n<0)return;if(n==0){if(!sys_disk_ok()){notice("Save unavailable","Insert an SD card; the study remains in memory.");continue;}pico_f_mkdir("studies");char path[320];if(document_save_name("studies",".study",path,sizeof path)){bool ok=research_save(path);notice(ok?"Study saved":"Save failed",ok?"Equations, data, units and settings are saved together. Results are recalculated only when requested.":"The previous valid file and current study are retained.");}}
 if(n==1){if(!sys_disk_ok()){notice("Open unavailable","Insert an SD card.");continue;}char path[320];if(document_file("studies",".study",path,sizeof path)&&(!research->dirty||confirm("Replace the unsaved study?"))){bool backup=false;bool ok=research_read(path,backup);notice(ok?(backup?"Backup loaded":"Study opened"):"Open failed",ok?"Inputs restored. No calculations were run.":"Invalid or unavailable file; the current study is retained.");}}
