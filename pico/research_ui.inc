 if(n==1){const char *items[]={"Discrete convolution","Cross-correlation sum A[i]*B[i+lag]"};int action=screen_menu("research.convolution","Two-signal operation",items,2);if(action<0)continue;auto &a=research->data[0];auto &b=research->data[1];if(!a.rows||!b.rows||a.rows+b.rows-1>128){notice("Signal length unavailable","Capture nonempty A and B with combined output length A+B-1 <=128. No tail is silently discarded.");continue;}pico_data_table out;out.rows=a.rows+b.rows-1;bool ok=true;for(unsigned i=0;i<out.rows;++i){if(science_poll(nullptr)){ok=false;break;}int index=action?int(i)-int(a.rows)+1:int(i);out.points[i][0]=index/research->fs;out.points[i][1]=pico_research::convolution(a,b,index,action);}if(!ok||!out.valid()){notice("Signal calculation stopped","Cancelled or numerical range exceeded; inputs are unchanged.");continue;}research_plot_table(out,action?"Cross correlation | lag seconds":"Discrete convolution | seconds");}
