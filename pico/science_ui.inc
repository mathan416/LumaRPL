namespace {
pico_science_document *science=nullptr;pico_document_cache<pico_science_document> science_cache;
bool science_get_data_units(char *x,char *y,size_t capacity){*x=*y=0;if(!science_cache.resident&&!science_cache.handle)return true;if(science){snprintf(x,capacity,"%s",science->xunit);snprintf(y,capacity,"%s",science->yunit);return true;}pico_document_access<pico_science_document> access(science_cache,science);if(!science)return false;snprintf(x,capacity,"%s",science->xunit);snprintf(y,capacity,"%s",science->yunit);return true;}
bool science_poll(void *){return sampling_poll(nullptr,0);}
void science_help(unsigned mode){const char *id=mode==0?"science.units_help":mode==1?"science.uncertainty_help":mode==2?"science.fitting_help":mode==3?"science.discrete_help":"science.signal_help";screen_text(id,"Applied mathematics help",pico_ui_help::tool_text(id),strlen(pico_ui_help::tool_text(id)));}
void science_files(unsigned mode){for(;;){const char *items[]={"Save applied-math inputs","Load applied-math inputs","Help"};int n=screen_menu("science.files","Files / help",items,3);if(n<0)return;if(n==0)math_file_save(*science,"science",".science");if(n==1)math_file_load(*science,"science",".science");if(n==2)science_help(mode);}}
bool science_data(pico_data_table &data){pico_document_access<pico_data_table> access(data_cache,data_table);if(!data_table){notice("Data unavailable","Open or import a table in Data / statistics first.");return false;}data=*data_table;if(!data.rows||!data.valid()){notice("Data unavailable","Enter or import finite X,Y observations first.");return false;}return true;}
bool science_replace_data(const pico_data_table &data){if(!confirm("Replace the current X,Y table? Save its CSV first if you need it."))return false;pico_document_access<pico_data_table> access(data_cache,data_table);if(!data_table){notice("Data unavailable","Not enough document memory; current data retained.");return false;}*data_table=data;data_table->dirty=true;return true;}
void science_export(const pico_data_table &data,const char *saved="Saved under /db48x/exports. Unit labels remain in the .science document."){if(!sys_disk_ok()){notice("Export unavailable","Insert an SD card; the current data are retained.");return;}char path[320];pico_f_mkdir("exports");if(document_save_name("exports",".csv",path,sizeof path)){bool ok=pico_data_save(path,data);notice(ok?"CSV exported":"Export failed",ok?saved:"Previous valid file retained.");}}
void science_plot(pico_data_table &data,const char *title){if(!data.rows)return;auto r=plot_request();r.active[0]=1;r.active[1]=r.active[2]=0;double xmin=data.points[0][0],xmax=xmin,ymin=data.points[0][1],ymax=ymin;for(unsigned i=0;i<data.rows;++i){xmin=fmin(xmin,data.points[i][0]);xmax=fmax(xmax,data.points[i][0]);ymin=fmin(ymin,data.points[i][1]);ymax=fmax(ymax,data.points[i][1]);}if(xmin==xmax){xmin-=1;xmax+=1;}double pad=.1*fmax(1e-12,ymax-ymin);if(ymin==ymax)pad=.1*fmax(1.,fabs(ymin));r.window[0]=xmin;r.window[1]=xmax;r.window[2]=ymin-pad;r.window[3]=ymax+pad;plot_label(r.label[0],80,title);
 auto sample=[](void *p,int,double x,double,double *y){return pico_science::interpolate(*static_cast<pico_data_table *>(p),x,0,*y)?1:0;};plot_source source{sample,&data};source.scatter=&data;plot_curves(r,source);}
void science_unit_fields(){for(;;){char x[64],y[64];snprintf(x,sizeof x,"X units: %s",*science->xunit?science->xunit:"dimensionless");snprintf(y,sizeof y,"Y units: %s",*science->yunit?science->yunit:"dimensionless");const char *items[]={x,y};int n=screen_menu("science.data_units","Data units (CSV magnitudes)",items,2);if(n<0)return;char units[24];strcpy(units,n?science->yunit:science->xunit);if(prompt("Units (empty = dimensionless)",units,sizeof units)){if(pico_quantity_affine(units)){notice("Units unavailable","Use absolute kelvin for numerical analysis; affine temperatures are not supported here.");continue;}if(*units){pico_workbench_scope scope;unit_g check=pico_form_unit(units);if(!scope.entered||!check){engine_error();continue;}}strcpy(n?science->yunit:science->xunit,units);science->dirty=true;}}}
void science_units(){for(;;){const char *items[]={"Quantity / expression","Target units (optional)","Evaluate / convert","Formula forms (named unit inputs)","Unit conversion","Data X,Y units","Files / help"};int n=screen_menu("science.units","Units and dimensions",items,7);if(n<0)return;if(n==0){char text[160];strcpy(text,science->quantity);if(formula_entry("Unit expression",text,false,false,false,"Examples: (12_V)/(4_ohm), (2_m)+(30_cm)")){strcpy(science->quantity,text);science->dirty=true;}}if(n==1){char units[32];strcpy(units,science->target);if(prompt("Target unit (empty = retain result)",units,sizeof units)){pico_workbench_scope scope;if(*units&&!pico_form_unit(units)){engine_error();continue;}strcpy(science->target,units);science->dirty=true;}}
 if(n==2){pico_workbench_scope scope;if(!scope.entered){engine_error();continue;}object_g value=pico_quantity_parse(science->quantity);algebraic_g result=value?value->as_algebraic():nullptr;if(result&&*science->target){unit_g target=pico_form_unit(science->target);if(!target||!target->convert(result))result=nullptr;}if(!result){engine_error();continue;}screen_result("science.quantity_result",result,"Unit result","Dimensions are checked by DB48X. Copy is explicit.");}
 if(n==3)pico_forms_menu();if(n==4)unit_conversion_menu();if(n==5)science_unit_fields();if(n==6)science_files(0);
 }}
void science_uncertainty(){for(;;){const char *items[]={"Formula F(A,B,C)","Measurement A","Measurement B","Measurement C","Output units (optional)","Propagate independent uncertainties","Files / help"};int n=screen_menu("science.uncertainty","Measurement uncertainty",items,7);if(n<0)return;if(n==0){char text[160];strcpy(text,science->formula);if(formula_entry("F(A,B,C)",text,false,false,false,"Independent measurements A, B, C; radians")){strcpy(science->formula,text);science->dirty=true;}}
 if(n>=1&&n<=3){pico_science_document next=*science;unsigned i=n-1;if(prompt("Nominal value (units accepted)",next.value[i],64)&&prompt("Standard uncertainty (>=0, same units)",next.sigma[i],64)&&prompt("Declared units (empty = infer from value)",next.units[i],24)){next.dirty=true;*science=next;}}
 if(n==4){char units[32];strcpy(units,science->output);if(prompt("Output units (empty = infer)",units,sizeof units)){if(*units){pico_workbench_scope scope;if(!pico_form_unit(units)){engine_error();continue;}}strcpy(science->output,units);science->dirty=true;}}
 if(n==5){screen_page("science.busy","Propagating uncertainty",{{nullptr,nullptr,nullptr,nullptr,"Cancel"}});flush_display();pico_uncertainty_result r;if(!pico_uncertainty(*science,r)){if(rt.error())engine_error();else notice("Uncertainty unavailable","Check nonnegative uncertainties, compatible units and a smooth formula. Use kelvin rather than affine temperatures.");continue;}char text[1000];snprintf(text,sizeof text,"%.12g +/- %.8g %s\n\nIndependent standard uncertainty (one sigma).\nContribution A: %.8g\nContribution B: %.8g\nContribution C: %.8g\n\nFirst-order numerical linearization, not a confidence interval. Correlations are not included; large uncertainties or nonlinear models need another method.\n\nCopy: [nominal, standard uncertainty] in %s.",r.nominal,r.sigma,r.unit,r.contribution[0],r.contribution[1],r.contribution[2],*r.unit?r.unit:"dimensionless units");if(screen_text("science.uncertainty_result","Propagated result",text,strlen(text),pico_ui::TextRole::prose,{{"Copy values",nullptr,nullptr,nullptr,"Back"}})==1){object_g result=pico_uncertainty_values(r);if(!result||!rt.push(result))engine_error();}}
 if(n==6)science_files(1);
 }}
struct science_curve_context {const pico_data_table *data;unsigned method;pico_science_evaluator *evaluator=nullptr;const double *parameters=nullptr;bool residual=false;static int sample(void *p,int curve,double x,double,double *y){auto &c=*static_cast<science_curve_context *>(p);if(curve==0&&!c.residual)return pico_science::interpolate(*c.data,x,c.method,*y)?1:0;if(!c.evaluator)return 0;return pico_science_evaluator::fit(c.evaluator,x,c.parameters,*y)?1:0;}};
void science_fit_plot(pico_data_table &data,const double *parameters=nullptr){if(!pico_science::ordered(data)){notice("Ordered X required","Use at least two strictly increasing X values. Duplicate or unsorted X is not interpolated.");return;}pico_science_evaluator evaluator(science->fit);if(parameters&&!evaluator.valid()){engine_error();return;}science_curve_context c{&data,science->interpolation,parameters?&evaluator:nullptr,parameters};auto r=plot_request();r.active[0]=1;r.active[1]=parameters!=nullptr;r.active[2]=0;r.window[0]=data.points[0][0];r.window[1]=data.points[data.rows-1][0];double lo=INFINITY,hi=-INFINITY;for(unsigned i=0;i<data.rows;++i){lo=fmin(lo,data.points[i][1]);hi=fmax(hi,data.points[i][1]);}double pad=.15*fmax(1e-12,hi-lo);if(lo==hi)pad=.1*fmax(1.,fabs(lo));r.window[2]=lo-pad;r.window[3]=hi+pad;snprintf(r.label[0],80,"%s | X:%s Y:%s",science->interpolation?"PCHIP":"Linear",*science->xunit?science->xunit:"1",*science->yunit?science->yunit:"1");snprintf(r.label[1],80,"Fit: %.70s",science->fit);plot_source source{science_curve_context::sample,&c};source.scatter=&data;plot_curves(r,source);}
void science_fitting(){for(;;){const char *items[]={science->interpolation?"Interpolation: shape-preserving cubic":"Interpolation: linear","Evaluate between samples","Plot interpolation","Nonlinear model and guesses","Fit A,B,C to current table","Create exponential demo","Data units","Files / help"};int n=screen_menu("science.fitting","Interpolation / curve fitting",items,8);if(n<0)return;if(n==0){science->interpolation^=1;science->dirty=true;}
 if(n==1||n==2||n==4){pico_data_table data;if(!science_data(data))continue;if(n==1){double x=science->at;if(!analysis_quantity("X to interpolate (within sample range)",x,science->xunit))continue;double y;if(!pico_science::interpolate(data,x,science->interpolation,y)){notice("Interpolation unavailable","Use strictly increasing, distinct X values and a point inside the sampled range. Extrapolation is not performed.");continue;}science->at=x;science->dirty=true;object_g result=pico_quantity_number(y,science->yunit);screen_result("science.interpolation_result",result,"Interpolated Y","Interpolation estimates between observations; it is not a fitted physical model.");}
 if(n==2)science_fit_plot(data);
 if(n==4){pico_science_evaluator evaluator(science->fit);if(!evaluator.valid()){engine_error();continue;}screen_page("science.busy","Fitting A, B and C",{{nullptr,nullptr,nullptr,nullptr,"Cancel"}});flush_display();auto result=pico_science::fit(data,science->guesses,pico_science_evaluator::fit,&evaluator,science_poll);if(result.status!=1){if(rt.error())engine_error();else notice("Fit unavailable",result.status==-1?"Cancelled. Initial guesses and data are retained.":result.status==-2?"Singular model or convergence/evaluation limit. Try different guesses, units or a better-spread sample.":"Model undefined at a trial point. Check the domain and initial guesses.");continue;}
 for(;;){const char *actions[]={"View / copy coefficients","Plot fit with data","Plot residuals","Use coefficients as next guesses"};int a=screen_menu("science.fit_actions","Converged nonlinear fit",actions,4);if(a<0)break;
 if(a==0){char text[900];snprintf(text,sizeof text,"A: %.12g\nB: %.12g\nC: %.12g\nResidual sum of squares: %.10g\n\nUnweighted local least squares. Different guesses may produce different solutions. Coefficients use the declared X,Y magnitudes; no confidence intervals are inferred.\n\nCopy: [A,B,C].",result.p[0],result.p[1],result.p[2],result.rss);advanced_values("science.fit_result","Fit coefficients",text,result.p,3);}
 if(a==1)science_fit_plot(data,result.p);if(a==2){pico_data_table residual=data;bool ok=true;for(unsigned i=0;i<data.rows;++i){double f;if(!pico_science_evaluator::fit(&evaluator,data.points[i][0],result.p,f)){ok=false;break;}residual.points[i][1]-=f;}if(ok)science_plot(residual,"Residual Y | declared units");else engine_error();}
 if(a==3){memcpy(science->guesses,result.p,sizeof result.p);science->dirty=true;}
 }
 }}
 if(n==3){pico_science_document next=*science;if(formula_entry("Model F(X,A,B,C)",next.fit,false,false,false,"X and coefficients are in declared numerical units")&&analysis_number("Initial A",next.guesses[0])&&analysis_number("Initial B",next.guesses[1])&&analysis_number("Initial C",next.guesses[2])){next.dirty=true;*science=next;}}
 if(n==5){pico_data_table demo;demo.rows=12;for(unsigned i=0;i<demo.rows;++i){double x=i*.2;demo.points[i][0]=x;demo.points[i][1]=2*exp(.5*x)+1;}if(science_replace_data(demo)){*science->xunit=*science->yunit=0;science->dirty=true;}}
 if(n==6)science_unit_fields();if(n==7)science_files(2);
 }}
void science_discrete(){for(;;){const char *items[]={"Edit integers A, B, modulus M","Integer calculations","Recurrence U(N+1)=F(N,U)","Generate recurrence table","Files / help"};int n=screen_menu("science.discrete","Discrete mathematics",items,5);if(n<0)return;if(n==0){pico_science_document next=*science;if(prompt("A (unsigned integer <=1e12)",next.integers[0],32)&&prompt("B (unsigned integer <=1e12)",next.integers[1],32)&&prompt("Modulus M (1..1e12)",next.integers[2],32)){uint64_t v;bool ok=true;for(auto &s:next.integers)ok&=pico_science_integer(s,v);if(!ok){notice("Integer required","Use decimal unsigned whole numbers, at most 1e12. Values are not rounded.");continue;}next.dirty=true;*science=next;}}
 if(n==1)for(;;){const char *ops[]={"GCD(A,B)","LCM(A,B)","A modulo B","A^B modulo M","Prime factors of A (2..1e9)","Combinations A choose B","Permutations A pick B"};int a=screen_menu("science.integer_operations","Exact integer calculations",ops,7);if(a<0)break;lab_result(pico_discrete_calculate(*science,a),ops[a],a>=5?"Require 0 <= B <= A <= 1000. Exact upstream integer arithmetic.":a==4?"Repeated prime factors are retained. Esc interrupts trial division.":"Unsigned integers <=1e12. Modulus/divisor must be positive.");}
 if(n==2){pico_science_document next=*science;double terms=next.terms;if(formula_entry("F(N,U)",next.recurrence,false,false,false,"Next value from current N and U; dimensionless")&&analysis_number("Initial U at N=0",next.initial)&&analysis_number("Number of rows (1..128)",terms)){if(terms<1||terms>128||terms!=floor(terms)){notice("Row count","Choose a whole number from 1 to 128.");continue;}next.terms=terms;next.dirty=true;*science=next;}}
 if(n==3){pico_data_table result;result.rows=science->terms;pico_science_evaluator e(science->recurrence);if(!e.valid()){engine_error();continue;}double u=science->initial;bool ok=true;for(unsigned i=0;i<result.rows;++i){if(science_poll(nullptr)||!std::isfinite(u)||fabs(u)>1e100){ok=false;break;}result.points[i][0]=i;result.points[i][1]=u;if(i+1<result.rows&&!e.recurrence(i,u,u)){ok=false;break;}}if(!ok){if(rt.error())engine_error();else notice("Sequence interrupted","No partial table was installed. Check domain/range or retry.");continue;}
 for(;;){const char *actions[]={"View sequence","Plot sequence","Export CSV","Replace current X,Y table"};int a=screen_menu("science.sequence_actions","Generated sequence",actions,4);if(a<0)break;if(a==0){char text[3600];size_t used=0;for(unsigned i=0;i<result.rows;++i){int n=snprintf(text+used,sizeof text-used,"N=%u  U=%.12g\n",i,result.points[i][1]);if(n<0||size_t(n)>=sizeof text-used){snprintf(text+used,sizeof text-used,"Further rows omitted; use CSV for all rows.");break;}used+=n;}screen_text("science.sequence_result","Recurrence values",text,strlen(text));}if(a==1)science_plot(result,"Recurrence | N, U(N)");if(a==2)science_export(result);if(a==3&&science_replace_data(result)){*science->xunit=*science->yunit=0;science->dirty=true;}}
 }
 if(n==4)science_files(3);
 }}
struct science_spectrum_plot {pico_science::spectrum *s;bool phase;static int sample(void *p,int,double x,double,double *y){auto &c=*static_cast<science_spectrum_plot *>(p);auto &s=*c.s;if(x<0||x>s.fs/2)return 0;double bin=x*s.n/s.fs;unsigned a=std::min(s.n/2-1,unsigned(bin));double first=c.phase?s.phase(a):s.amplitude(a),last=c.phase?s.phase(a+1):s.amplitude(a+1);if(c.phase&&fabs(last-first)>180)return 0;*y=first+(bin-a)*(last-first);return std::isfinite(*y)?1:0;}};
void science_spectrum_view(pico_science::spectrum &s){for(;;){const char *actions[]={"Amplitude spectrum","Phase spectrum (degrees)","Frequency / amplitude table","Export amplitude CSV"};int a=screen_menu("science.spectrum","One-sided FFT",actions,4);if(a<0)return;
 if(a==0||a==1){science_spectrum_plot p{&s,a==1};auto r=plot_request();r.active[0]=1;r.active[1]=r.active[2]=0;r.window[0]=0;r.window[1]=s.fs/2;r.window[2]=a==1?-185:0;double peak=0;for(unsigned i=0;i<=s.n/2;++i)peak=fmax(peak,s.amplitude(i));r.window[3]=a==1?185:fmax(1e-12,peak*1.15);snprintf(r.label[0],80,a==1?"Phase degrees | X:Hz | weak bins omitted":"Peak amplitude %s | X:Hz | df=%.6g",*science->yunit?science->yunit:"",s.fs/s.n);plot_curves(r,{science_spectrum_plot::sample,&p});}
 if(a==2){char text[3600];size_t used=snprintf(text,sizeof text,"N=%u  Fs=%.10g Hz  df=%.10g Hz\n\n",s.n,s.fs,s.fs/s.n);for(unsigned i=0;i<=s.n/2;++i){int n=snprintf(text+used,sizeof text-used,"f=%.8g Hz  amplitude=%.10g\n",s.frequency(i),s.amplitude(i));if(n<0||size_t(n)>=sizeof text-used)break;used+=n;}screen_text("science.spectrum_table","FFT bins (peak amplitudes)",text,strlen(text));}
 if(a==3){pico_data_table data;data.rows=s.n/2+1;for(unsigned i=0;i<data.rows;++i){data.points[i][0]=s.frequency(i);data.points[i][1]=s.amplitude(i);}science_export(data);}
 }}
void science_signal_settings(){for(;;){char rate[72],window[48],demean[48];snprintf(rate,sizeof rate,"Sample rate: %.10g Hz",science->fs);snprintf(window,sizeof window,"Window: %s",science->window==0?"rectangular":science->window==1?"Hann":"Hamming");snprintf(demean,sizeof demean,"Remove mean: %s",science->demean?"yes":"no");const char *items[]={rate,window,demean};int a=screen_menu("science.signal_settings","FFT settings",items,3);if(a<0)return;if(a==0){double v=science->fs;if(analysis_quantity("Sample rate (Hz; unit quantities accepted)",v,"Hz")){if(v<=0||science->cutoff>=v/2){notice("Invalid sample rate","Use a positive rate greater than twice the filter cutoff, or lower the cutoff first.");continue;}science->fs=v;science->dirty=true;}}if(a==1){science->window=(science->window+1)%3;science->dirty=true;}if(a==2){science->demean^=1;science->dirty=true;}}}
void science_filter(){for(;;){const char *items[]={science->filter==0?"Filter: centered moving average":science->filter==1?"Filter: one-pole low-pass":"Filter: one-pole high-pass","Cutoff frequency / average span","Run filter on data Y"};int a=screen_menu("science.filter","Time-domain filters",items,3);if(a<0)return;if(a==0){science->filter=(science->filter+1)%3;science->dirty=true;}
 if(a==1){pico_science_document next=*science;double span=next.span;if(analysis_quantity("Cutoff frequency (0 < f < Fs/2)",next.cutoff,"Hz")&&analysis_number("Moving average span (odd 3..31)",span)){if(span<3||span>31||span!=floor(span)||!(unsigned(span)&1)||next.cutoff<=0||next.cutoff>=next.fs/2){notice("Invalid filter","Use an odd span 3..31 and cutoff below half the sample rate.");continue;}next.span=span;next.dirty=true;*science=next;}}
 if(a==2){pico_data_table in,out;if(!science_data(in))continue;if(!pico_science::filtered(in,out,science->fs,science->cutoff,science->filter,science->span,science_poll)){notice("Filter unavailable","Cancelled or numerical range exceeded; the original data are retained.");continue;}for(;;){const char *actions[]={"Plot filtered samples","Export filtered CSV","Replace current X,Y table"};int n=screen_menu("science.filter_actions","Filtered data (not yet stored)",actions,3);if(n<0)break;if(n==0)science_plot(out,"Filtered Y | original X coordinates");if(n==1)science_export(out);if(n==2)science_replace_data(out);}}
 }}
void science_signals(){for(;;){const char *items[]={"Analyze FFT of data Y","FFT settings","Infer sample rate from X times","Time-domain filters","Create 32-sample sine demo","Data units","Files / help"};int n=screen_menu("science.signals","Signal analysis",items,7);if(n<0)return;
 if(n==0){pico_data_table data;if(!science_data(data))continue;std::unique_ptr<pico_science::spectrum> result(new(std::nothrow) pico_science::spectrum);if(!result){notice("FFT unavailable","Not enough bounded memory; data retained.");continue;}screen_page("science.busy","Computing FFT",{{nullptr,nullptr,nullptr,nullptr,"Cancel"}});flush_display();if(!result->compute(data,science->fs,science->window,science->demean,science_poll)){notice("FFT unavailable","Use exactly 8, 16, 32, 64 or 128 finite samples. Esc cancels. Data must represent uniform sampling at the declared rate.");continue;}science_spectrum_view(*result);}
 if(n==1)science_signal_settings();
 if(n==2){pico_data_table data;if(!science_data(data)||!pico_science::ordered(data)){notice("Time samples required","Use increasing, uniformly spaced X times. Empty X units mean seconds.");continue;}double dt=data.points[1][0]-data.points[0][0];bool ok=true;for(unsigned i=2;i<data.rows;++i)if(fabs((data.points[i][0]-data.points[i-1][0])-dt)>1e-6*fmax(1e-300,fabs(dt)))ok=false;if(!ok){notice("Uneven sampling","Resample to uniform times before FFT. No sample rate was changed.");continue;}pico_workbench_scope scope;double seconds=dt;if(*science->xunit){algebraic_g time=pico_quantity_number(dt,science->xunit);if(!pico_quantity_value(time,"s",seconds,false)){engine_error();continue;}}double rate=1/seconds;if(!std::isfinite(rate)||rate<=2*science->cutoff){notice("Rate unavailable","Use finite time spacing and a filter cutoff below half the resulting sample rate.");continue;}science->fs=rate;science->dirty=true;notice("Sample rate updated","FFT and filters now use the rate inferred from X.");}
 if(n==3)science_filter();
 if(n==4){pico_data_table demo;demo.rows=32;for(unsigned i=0;i<32;++i){demo.points[i][0]=double(i)/128;demo.points[i][1]=sin(6.283185307179586*16*i/128);}if(science_replace_data(demo)){science->fs=128;science->cutoff=10;strcpy(science->xunit,"s");*science->yunit=0;science->dirty=true;}}
 if(n==5)science_unit_fields();if(n==6)science_files(4);
 }}
void science_launch(int mode){if(rt.editing()){notice("Applied mathematics","Finish or cancel calculator entry first.");return;}pico_document_access<pico_science_document> access(science_cache,science);if(!science){notice("Applied mathematics","Not enough document memory; existing work is retained.");return;}save<bool> display(user_display_enable,false);settings::SaveAngleMode radians(object::ID_Rad);if(mode==0)science_units();if(mode==1)science_uncertainty();if(mode==2)science_fitting();if(mode==3)science_discrete();if(mode==4)science_signals();}
}
