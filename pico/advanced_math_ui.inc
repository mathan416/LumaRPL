struct advanced_ode_row {double x,y,z;};
struct advanced_ode_samples {
 pico_bulk_records<advanced_ode_row,201> rows;double first,last;
 bool solve(const pico_advanced_math &d){if(!rows.good()){notice("Solution unavailable","Not enough sample memory. Inputs are retained.");return false;}first=d.x0;last=d.last;pico_system_evaluator evaluator(d);if(!evaluator.valid()){engine_error();return false;}
 pico_system_ode::solver solver{pico_system_evaluator::sample,&evaluator,[](void *){return sampling_poll(nullptr,0);}};double x=first,y[2]={d.y0,d.z0},h=fabs(last-first)/200;
 screen_page("advanced.busy","Solving differential equations",{{nullptr,nullptr,nullptr,nullptr,"Cancel"}});flush_display();
 for(unsigned i=0;i<=200;++i){double target=pico_plot_engine::coordinate(first,last,i,200);if(!solver.advance(x,y,target,h)){if(rt.error())engine_error();else notice("Solution incomplete",solver.status==-2?"Cancelled. Inputs are retained.":solver.status==-3?"Step or evaluation limit reached. Try a shorter interval.":"Formula undefined or numerical range exceeded. Try another interval or initial condition.");return false;}rows[i]={x,y[0],y[1]};}
 return true;}
 int value(int curve,double x,double &v){double f=(x-first)/(last-first)*200;if(!std::isfinite(f)||f<0||f>200)return 0;unsigned i=std::min(199u,unsigned(f));auto a=rows[i],b=rows[i+1];v=(curve? a.z:a.y)+(f-i)*((curve?b.z:b.y)-(curve?a.z:a.y));return std::isfinite(v)?1:0;}
 static int sample(void *p,int c,double x,double,double *v){return static_cast<advanced_ode_samples *>(p)->value(c,x,*v);}
 static int phase(void *p,double t,double *x,double *y){auto &d=*static_cast<advanced_ode_samples *>(p);return d.value(0,t,*x)&&d.value(1,t,*y);}
 void plot(bool phase_plot){auto request=plot_request();request.active[0]=request.active[1]=1;request.active[2]=0;snprintf(request.label[0],80,phase_plot?"Phase: horizontal Y, vertical Z":"Y(X)");snprintf(request.label[1],80,"Z(X)");double lo=INFINITY,hi=-INFINITY,zlo=INFINITY,zhi=-INFINITY;for(unsigned i=0;i<=200;++i){auto r=rows[i];lo=fmin(lo,r.y);hi=fmax(hi,r.y);zlo=fmin(zlo,r.z);zhi=fmax(zhi,r.z);}auto expand=[](double &a,double &b){double pad=.1*fmax(1.,b-a);a-=pad;b+=pad;};
 if(phase_plot){request.window[0]=lo;request.window[1]=hi;request.window[2]=zlo;request.window[3]=zhi;expand(request.window[0],request.window[1]);expand(request.window[2],request.window[3]);pico_path_scene path;path.first=fmin(first,last);path.last=fmax(first,last);plot_source source{sample,this};source.path=&path;source.path_sample=phase;request.active[1]=0;plot_curves(request,source);}else{request.window[0]=fmin(first,last);request.window[1]=fmax(first,last);request.window[2]=fmin(lo,zlo);request.window[3]=fmax(hi,zhi);expand(request.window[2],request.window[3]);plot_curves(request,{sample,this});}}
 void table(){char text[3800];size_t used=snprintf(text,sizeof text,"Numerical solution samples\n\n");for(unsigned i=0;i<=200;i+=10){auto r=rows[i];int n=snprintf(text+used,sizeof text-used,"X=%.6g  Y=%.6g  Z=%.6g\n",r.x,r.y,r.z);if(n<0||size_t(n)>=sizeof text-used)break;used+=n;}screen_text("advanced.table","Solution table (every 10th sample)",text,used,pico_ui::TextRole::prose);}
};
