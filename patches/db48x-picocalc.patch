+static object::result fourier_transform(bool inverse)
+// ----------------------------------------------------------------------------
+//   Decimal radix-two transform; forward is unscaled, inverse divides by N
+// ----------------------------------------------------------------------------
+{
+    array_g input = array_p(rt.stack(0));
+    if (!input)
+        return object::ERROR;
+    if (input->type() != object::ID_array)
+    {
+        rt.type_error();
+        return object::ERROR;
+    }
+    size_t n = 0;
+    if (!input->is_vector(&n, false) || !n || (n & (n - 1)))
+    {
+        rt.dimension_error();
+        return object::ERROR;
+    }
+    // Bound scratch memory independently of the available object arena.
+    if (n > 1024)
+    {
+        rt.dimension_error();
+        return object::ERROR;
+    }
+    scoped_array<complex_g> values(n);
+    if (!values)
+    {
+        rt.out_of_memory_error();
+        return object::ERROR;
+    }
+    uint                                digits = Settings.Precision();
+    if(digits+24>DB48X_MAXDIGITS)
+    {
+        rt.precision_loss_error();
+        return object::ERROR;
+    }
+    settings::SavePrecision             precision(digits + 12);
+    settings::SaveHardwareFloatingPoint hardware(false);
+    settings::SaveNumericalResults      numerical(true);
+    settings::SaveAngleMode             radians(object::ID_Rad);
+    size_t                              index = 0;
+    for (object_p item : *input)
+    {
+        algebraic_g value = item->as_algebraic();
+        if (!value || !(values[index] = complex::from_algebraic(value)))
+        {
+            rt.type_error();
+            return object::ERROR;
+        }
+        ++index;
+    }
+    for (size_t i = 1, j = 0; i < n; ++i)
+    {
+        size_t bit = n >> 1;
+        while (j & bit)
+        {
+            j ^= bit;
+            bit >>= 1;
+        }
+        j ^= bit;
+        if (i < j)
+        {
+            complex_g temporary = values[i];
+            values[i]           = values[j];
+            values[j]           = temporary;
+        }
+    }
+    for (size_t width = 2; width <= n; width <<= 1)
+    {
+        for (size_t k = 0; k < width / 2; ++k)
+        {
+            if (program::interrupted())
+                return object::ERROR;
+            // Calculate each twiddle directly, avoiding accumulated phase
+            // error.
+            decimal_g angle = decimal::make(inverse ? 2 : -2);
+            angle           = angle * decimal_g(decimal::make(k)) /
+                    decimal_g(decimal::make(width));
+            complex_g twiddle;
+            {
+                settings::SaveAngleMode pi_radians(object::ID_PiRadians);
+                decimal_g               real = decimal::cos(angle),
+                          imag               = decimal::sin(angle);
+                twiddle =
+                    rectangular::make(algebraic_g(+real), algebraic_g(+imag));
+            }
+            if (!twiddle)
+                return object::ERROR;
+            for (size_t base = 0; base < n; base += width)
+            {
+                size_t    left = base + k, right = left + width / 2;
+                complex_g a = values[left], b = values[right] * twiddle;
+                values[left]  = a + b;
+                values[right] = a - b;
+                if (!values[left] || !values[right])
+                    return object::ERROR;
+            }
+        }
+    }
+    if (inverse)
+    {
+        complex_g divisor = complex::make(n);
+        for (size_t i = 0; i < n; ++i)
+        {
+            values[i] = values[i] / divisor;
+            if (!values[i])
+                return object::ERROR;
+        }
+    }
+    for (size_t i = 0; i < n; ++i)
+    {
+        algebraic_g real = values[i]->re(), imag = values[i]->im();
+        if (!algebraic::to_decimal(real) || !algebraic::to_decimal(imag))
+            return object::ERROR;
+        real = decimal_p(+real)->precision(digits);
+        imag = decimal_p(+imag)->precision(digits);
+        if (!(values[i] = rectangular::make(real, imag)))
+            return object::ERROR;
+    }
+    array_g result = array::build(n, 0, fourier_item, values.get());
+    return result && rt.top(result) ? object::OK : object::ERROR;
+}
