+static algebraic_p distribution_cdf(object::id command, algebraic_g *args)
+// ----------------------------------------------------------------------------
+//   Lower-tail distributions reuse the engine's decimal tail implementations
+// ----------------------------------------------------------------------------
+{
+    uint count =
+        command == object::ID_Normal || command == object::ID_FDistribution ? 3
+                                                                            : 2;
+    for (uint i = 0; i < count; ++i)
+        if (args[i]->is_symbolic())
+            return expression::make(command,
+                                    args,
+                                    count,
+                                    object::ID_expression,
+                                    true);
+    for (uint i = 0; i < count; ++i)
+        if (!args[i]->is_real())
+        {
+            rt.type_error();
+            return nullptr;
+        }
+    algebraic_g one = integer::make(1);
+    if (command == object::ID_Normal)
+    {
+        algebraic_g reflected[3] = { args[2] + args[2] - args[0],
+                                     args[1],
+                                     args[2] };
+        return UTPN::evaluate(object::ID_UTPN, reflected, 3);
+    }
+    if (command == object::ID_Student)
+    {
+        algebraic_g reflected[2] = { -args[0], args[1] };
+        return UTPT::evaluate(object::ID_UTPT, reflected, 2);
