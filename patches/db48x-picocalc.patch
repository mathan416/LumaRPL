diff --git a/src/alarms.inc b/src/alarms.inc
new file mode 100644
index 0000000000000000000000000000000000000000..d828a8bdc2a676505dccc215e6d224fe34edf869
--- /dev/null
+++ b/src/alarms.inc
@@ -0,0 +1,233 @@
+// Clock reminders are ordinary HOME data, included in calculator session saves.
+namespace {
+constexpr cstring alarm_data_name = "LumaAlarms";
+constexpr uint alarm_capacity = 32;
+
+ularge alarm_seconds(const dt_t &dt, const tm_t &tm)
+{
+    return julian_day_number(dt.day, dt.month, dt.year) * 86400ULL +
+           tm.hour * 3600ULL + tm.min * 60ULL + tm.sec;
+}
+
+ularge alarm_now()
+{
+    dt_t dt{};
+    tm_t tm{};
+    rtc_read(&tm, &dt);
+    return alarm_seconds(dt, tm);
+}
+
+list_p alarm_data()
+{
+    symbol_g name = symbol::make(alarm_data_name);
+    if (!name) return nullptr;
+    object_g data = rt.homedir()->recall(+name);
+    if (!data) return list::make(object::ID_list, nullptr, 0);
+    list_p rows = data->as<list>();
+    if (!rows || rows->items() > alarm_capacity)
+    {
+        rt.error("Invalid alarm data");
+        return nullptr;
+    }
+    for (object_p row : *rows)
+    {
+        list_p entry = row->as<list>();
+        if (!entry || entry->items() != 5 ||
+            !entry->at(0)->is_integer() || !entry->at(2)->as<text>() ||
+            !entry->at(3)->is_integer() || !entry->at(4)->is_integer())
+        {
+            rt.error("Invalid alarm data");
+            return nullptr;
+        }
+    }
+    return rows;
+}
+
+bool alarm_store(list_r rows)
+{
+    symbol_g name = symbol::make(alarm_data_name);
+    return name && rt.homedir()->store(+name, +rows);
+}
+
+// Select by due time, then ID; acknowledgement does not delete history.
+int alarm_due(list_r rows, ularge now)
+{
+    int selected = -1;
+    ularge earliest = ~ularge(0);
+    uint index = 0;
+    for (object_p row : *rows)
+    {
+        list_p entry = row->as<list>();
+        ularge due = entry->at(4)->as_uint64(0, false);
+        if (!entry->at(3)->as_uint32(0, false) && due <= now && due < earliest)
+        {
+            selected = int(index);
+            earliest = due;
+        }
+        ++index;
+    }
+    return selected;
+}
+
+bool alarm_change(list_r rows, int index, bool remove, bool all = false)
+{
+    scribble scr;
+    int n = 0;
+    ularge now = alarm_now();
+    for (object_g row : *rows)
+    {
+        list_g entry = row->as<list>();
+        if (n++ == index || (all && entry->at(4)->as_uint64(0, false) <= now))
+        {
+            if (remove) continue;
+            object_g id = entry->at(0), date = entry->at(1), msg = entry->at(2);
+            object_g due = entry->at(4);
+            integer_g ack = integer::make(1);
+            entry = list::make(id, date, msg, ack, due);
+            if (!entry) return false;
+        }
+        if (!scr.append(+entry)) return false;
+    }
+    list_g result = list::make(object::ID_list, scr.scratch(), scr.growth());
+    return result && alarm_store(result);
+}
+
+int alarm_index(list_r rows, object_p value)
+{
+    if (!value || !value->is_integer())
+    {
+        rt.type_error();
+        return -1;
+    }
+    ularge id = value->as_uint64(0, false);
+    int index = 0;
+    for (object_p row : *rows)
+    {
+        if (row->as<list>()->at(0)->as_uint64(0, false) == id)
+            return index;
+        ++index;
+    }
+    rt.error("Alarm not found");
+    return -1;
+}
+}
+
+COMMAND_BODY(Alarms)
+{
+    list_g rows = alarm_data();
+    return rows && rt.push(+rows) ? OK : ERROR;
+}
+
+COMMAND_BODY(StoAlarm)
+{
+    object_g date = rt.stack(1), message = rt.stack(0);
+    if (!message || !message->as<text>())
+    {
+        rt.type_error();
+        return ERROR;
+    }
+    dt_t dt{};
+    tm_t tm{};
+    if (!to_date(+date, dt, tm)) return ERROR;
+    list_g rows = alarm_data();
+    if (!rows) return ERROR;
+    if (rows->items() >= alarm_capacity)
+    {
+        rt.error("Too many alarms");
+        return ERROR;
+    }
+    ularge next = 1;
+    for (object_p row : *rows)
+    {
+        ularge id = row->as<list>()->at(0)->as_uint64(0, false);
+        if (id >= next) next = id + 1;
+    }
+    integer_g id = integer::make(next), ack = integer::make(0);
+    integer_g due = integer::make(alarm_seconds(dt, tm));
+    list_g entry = list::make(id, date, message, ack, due);
+    if (!entry) return ERROR;
+    scribble scr;
+    for (object_p existing : *rows)
+        if (!scr.append(existing)) return ERROR;
+    if (!scr.append(+entry)) return ERROR;
+    rows = list::make(object::ID_list, scr.scratch(), scr.growth());
+    if (!rows || !alarm_store(rows)) return ERROR;
+    rt.drop(1);
+    return rt.top(+id) ? OK : ERROR;
+}
+
+COMMAND_BODY(RclAlarm)
+{
+    list_g rows = alarm_data();
+    if (!rows) return ERROR;
+    int index = alarm_index(rows, rt.stack(0));
+    return index >= 0 && rt.top(rows->at(index)) ? OK : ERROR;
+}
+
+COMMAND_BODY(DelAlarm)
+{
+    list_g rows = alarm_data();
+    if (!rows) return ERROR;
+    int index = alarm_index(rows, rt.stack(0));
+    if (index < 0 || !alarm_change(rows, index, true)) return ERROR;
+    rt.drop(1);
+    return OK;
+}
+
+COMMAND_BODY(FindAlarm)
+{
+    dt_t dt{};
+    tm_t tm{};
+    if (!to_date(rt.stack(0), dt, tm)) return ERROR;
+    ularge after = alarm_seconds(dt, tm), earliest = ~ularge(0), found = 0;
+    list_g rows = alarm_data();
+    if (!rows) return ERROR;
+    for (object_p row : *rows)
+    {
+        list_p entry = row->as<list>();
+        ularge due = entry->at(4)->as_uint64(0, false);
+        if (!entry->at(3)->as_uint32(0, false) && due > after && due < earliest)
+        {
+            earliest = due;
+            found = entry->at(0)->as_uint64(0, false);
+        }
+    }
+    integer_g id = integer::make(found);
+    return id && rt.top(+id) ? OK : ERROR;
+}
+
+COMMAND_BODY(Ack)
+{
+    list_g rows = alarm_data();
+    if (!rows) return ERROR;
+    int index = alarm_due(rows, alarm_now());
+    return index < 0 || alarm_change(rows, index, false) ? OK : ERROR;
+}
+
+COMMAND_BODY(AckAll)
+{
+    list_g rows = alarm_data();
+    return rows && alarm_change(rows, -1, false, true) ? OK : ERROR;
+}
+
+bool alarm_notify()
+{
+    // Called only between calculations; never replace an existing error.
+    static uint32_t last_check;
+    uint32_t now = sys_current_ms();
+    if (uint32_t(now - last_check) < 1000 || rt.error() || !key_empty()) return false;
+    last_check = now;
+    // Avoid allocations during the common no-alarm case.
+    symbol_g name = symbol::make(alarm_data_name);
+    if (!name || !rt.homedir()->recall(+name)) return false;
+    list_g rows = alarm_data();
+    if (!rows) return false;
+    int index = alarm_due(rows, alarm_now());
+    if (index < 0) return false;
+    list_g entry = rows->at(index)->as<list>();
+    text_g message = entry->at(2)->as<text>();
+    ui.draw_message("Alarm reminder", message->null_terminated_value(),
+                    "Press Enter to acknowledge");
+    wait_for_key_press();
+    return alarm_change(rows, index, false);
+}
