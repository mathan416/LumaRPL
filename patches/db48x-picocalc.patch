+    if (!real || !imag || !algebraic::to_decimal(real) ||
+        !algebraic::to_decimal(imag))
+        return nullptr;
+    real = decimal_p(+real)->precision(digits);
+    imag = decimal_p(+imag)->precision(digits);
+    return rectangular::make(real, imag);
 }

