+static object::result modular_echelon()
+// ----------------------------------------------------------------------------
+//   Exact Gauss-Jordan elimination over the prime field selected by CASModulus
+// ----------------------------------------------------------------------------
+{
+    array_g input = array_p(rt.stack(0));
+    size_t  rows = 0, cols = 0;
+    if (!matrix_shape(input, rows, cols))
+        return object::ERROR;
+    uint32_t modulus = Settings.CASModulus();
+    for (uint32_t divisor = 2; uint64_t(divisor) * divisor <= modulus;
+         ++divisor)
+    {
+        if (program::interrupted())
+            return object::ERROR;
+        if (modulus % divisor == 0)
+        {
+            rt.domain_error();
+            return object::ERROR;
+        }
+    }
+    scoped_array<uint32_t> data(rows * cols);
+    if (!data)
+    {
+        rt.out_of_memory_error();
+        return object::ERROR;
+    }
+    size_t      r = 0;
+    algebraic_g m = integer::make(modulus);
+    for (object_p row : *input)
+    {
+        list_g line = list_p(row);
+        size_t c    = 0;
+        for (object_p item : *line)
+        {
+            algebraic_g value = item->as_algebraic();
+            if (!value || !value->is_integer())
+            {
+                rt.type_error();
+                return object::ERROR;
+            }
+            value = mod::evaluate(value, m);
+            if (!value)
+                return object::ERROR;
+            data[r * cols + c++] = value->as_uint32(0, true);
+        }
+        ++r;
+    }
+    size_t pivot_row = 0, end = cols;
+    if (Settings.EchelonFormKeepLastColumn() && end)
+        --end;
+    for (size_t col = 0; col < end && pivot_row < rows; ++col)
+    {
+        if (program::interrupted())
+            return object::ERROR;
+        size_t pivot = pivot_row;
+        while (pivot < rows && !data[pivot * cols + col])
+            ++pivot;
+        if (pivot == rows)
+            continue;
+        for (size_t j = 0; j < cols; ++j)
+        {
+            uint32_t temporary         = data[pivot_row * cols + j];
+            data[pivot_row * cols + j] = data[pivot * cols + j];
+            data[pivot * cols + j]     = temporary;
+        }
+        uint64_t inverse = 1, power = data[pivot_row * cols + col];
+        for (uint32_t exponent = modulus - 2; exponent; exponent >>= 1)
+        {
+            if (exponent & 1)
+                inverse = inverse * power % modulus;
+            power = power * power % modulus;
+        }
+        for (size_t j = 0; j < cols; ++j)
+        {
+            data[pivot_row * cols + j] =
+                uint64_t(data[pivot_row * cols + j]) * inverse % modulus;
+        }
+        for (size_t i = 0; i < rows; ++i)
+        {
+            if (i == pivot_row)
+                continue;
+            uint64_t factor = data[i * cols + col];
+            for (size_t j = 0; j < cols; ++j)
+            {
+                data[i * cols + j] =
+                    (data[i * cols + j] + modulus -
+                     factor * data[pivot_row * cols + j] % modulus) %
+                    modulus;
+            }
+        }
+        ++pivot_row;
+    }
+    modular_matrix context{ data.get(), cols };
+    array_g result = array::build(rows, cols, modular_matrix::item, &context);
+    return result && rt.top(result) ? object::OK : object::ERROR;
+}
