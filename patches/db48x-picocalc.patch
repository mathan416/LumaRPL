+// ----------------------------------------------------------------------------
+//   Taylor polynomial from expression, variable, expansion point and order
+// ----------------------------------------------------------------------------
+{
+    expression_g derivative = expression::get(args[3]);
+    symbol_g     variable   = args[2]->as_quoted<symbol>();
+    algebraic_g  point = args[1], degree = args[0];
+    if (!derivative || !variable || !degree->is_integer() ||
+        degree->is_negative(false))
+    {
+        rt.type_error();
+        return nullptr;
+    }
+    uint order = degree->as_uint32(1001, false);
+    if (order > 1000)
+    {
+        rt.domain_error();
+        return nullptr;
+    }
+    save<symbol_g *> independent(expression::independent, &variable);
+    settings::SaveNumericalResults symbolic(false);
+    settings::SaveAngleMode        radians(ID_Rad);
+    expression_g                   displacement =
+        expression::make(ID_subtract, algebraic_g(+variable), point);
+    algebraic_g sum = integer::make(0), factorial = integer::make(1);
+    for (uint n = 0; n <= order; ++n)
+    {
+        if (program::interrupted())
+            return nullptr;
+        algebraic_g coefficient =
+            algebraic::evaluate_function(program_g(program_p(+derivative)),
+                                         point);
+        if (!coefficient)
+            return nullptr;
+        coefficient        = coefficient / factorial;
+        expression_g power = expression::make(ID_pow,
+                                              algebraic_g(+displacement),
+                                              algebraic_g(integer::make(n)));
+        expression_g term =
+            expression::make(ID_multiply, coefficient, algebraic_g(+power));
+        sum = expression::make(ID_add, sum, algebraic_g(+term));
+        if (!sum)
+            return nullptr;
+        if (n < order)
+        {
+            derivative = derivative->derivative(variable);
+            factorial  = factorial * algebraic_g(integer::make(n + 1));
+            if (!derivative || !factorial)
+                return nullptr;
+        }
+    }
+    expression_g result = expression::get(sum);
+    return result ? result->simplify() : nullptr;
