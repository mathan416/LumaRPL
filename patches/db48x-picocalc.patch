+                  : nullptr;
+}
+
+static bool limit_analytic(expression_r expression)
+// ----------------------------------------------------------------------------
+//   Avoid guessing limits across discontinuities or unevaluated commands
+// ----------------------------------------------------------------------------
+{
+    for (object_p item : *expression)
+    {
+        if (item->is_real() || item->is_complex() || item->is_symbolic())
+            continue;
+        switch (item->type())
+        {
+        case object::ID_add:
+        case object::ID_subtract:
+        case object::ID_multiply:
+        case object::ID_divide:
+        case object::ID_pow:
+        case object::ID_neg:
+        case object::ID_sq:
+        case object::ID_cubed:
+        case object::ID_sin:
+        case object::ID_cos:
+        case object::ID_tan:
+        case object::ID_exp:
+        case object::ID_expm1:
+        case object::ID_ln:
+        case object::ID_ln1p:
+        case object::ID_sqrt:
+        case object::ID_cbrt: break;
+        default: return false;
+        }
+    }
+    return true;
+}
+
+NFUNCTION_BODY(Limit)
+// ----------------------------------------------------------------------------
+//   Finite analytic limits, including removable zeros via l'Hopital's rule
+// ----------------------------------------------------------------------------
+{
+    expression_g source   = expression::get(args[2]);
+    symbol_g     variable = args[1]->as_quoted<symbol>();
+    algebraic_g  point    = args[0];
+    if (!source || !variable || !point->is_real())
+    {
+        rt.type_error();
+        return nullptr;
+    }
+    if (!limit_analytic(source))
+    {
+        rt.domain_error();
+        return nullptr;
+    }
+    save<symbol_g *> independent(expression::independent, &variable);
+    settings::SaveAngleMode radians(ID_Rad);
+    expression_g     numerator, denominator;
+    if (!source->split(object::ID_divide, numerator, denominator))
+    {
+        return algebraic::evaluate_function(program_g(program_p(+source)),
+                                            point);
+    }
+    for (uint iteration = 0; iteration < 64; ++iteration)
+    {
+        if (program::interrupted())
+            return nullptr;
+        algebraic_g n =
+            algebraic::evaluate_function(program_g(program_p(+numerator)),
+                                         point);
+        if (!n)
+            return nullptr;
+        algebraic_g d =
+            algebraic::evaluate_function(program_g(program_p(+denominator)),
+                                         point);
+        if (!n || !d)
+            return nullptr;
+        if (!d->is_zero(false))
+            return n / d;
+        if (!n->is_zero(false))
+        {
+            rt.domain_error();
+            return nullptr;
+        }
+        numerator   = numerator->derivative(variable);
+        denominator = denominator->derivative(variable);
+        if (!numerator || !denominator)
+            return nullptr;
+    }
+    rt.precision_loss_error();
+    return nullptr;
+}
