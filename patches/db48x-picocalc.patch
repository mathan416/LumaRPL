@@ -0,0 +1,962 @@
+// Decimal matrix factorizations. Scratch entries remain rooted across GC.
+namespace
+{
+algebraic_p matrix_round(algebraic_r value, uint digits)
+{
+    if (!value)
+        return nullptr;
+    return value->is_decimal()
+             ? algebraic_p(decimal_p(+value)->precision(digits))
+             : +value;
+}
+
+struct numeric_matrix
+{
+    size_t                    rows, cols;
+    scoped_array<algebraic_g> cells;
+    numeric_matrix(size_t r, size_t c) : rows(r), cols(c), cells(r * c)
+    {
+    }
+    algebraic_g &at(size_t r, size_t c)
+    {
+        return cells[r * cols + c];
+    }
+    bool valid()
+    {
+        return !!cells;
+    }
+    bool identity()
+    {
+        if (!valid())
+            return false;
+        for (size_t r = 0; r < rows; ++r)
+        {
+            for (size_t c = 0; c < cols; ++c)
+                if (!(at(r, c) = integer::make(r == c)))
+                    return false;
+        }
+        return true;
+    }
+    bool load(array_r input)
+    {
+        if (!valid())
+            return false;
+        size_t r = 0;
+        for (object_p row : *input)
+        {
+            list_g line = list_p(row);
+            size_t c    = 0;
+            for (object_p item : *line)
+            {
+                algebraic_g value = item->as_algebraic();
+                if (!value || !value->is_real())
+                {
+                    rt.type_error();
+                    return false;
+                }
+                if (!algebraic::to_decimal(value))
+                    return false;
+                at(r, c++) = value;
+            }
+            ++r;
+        }
+        return true;
+    }
+    static object_p item(size_t, size_t, size_t r, size_t c, void *data)
+    {
+        return static_cast<numeric_matrix *>(data)->at(r, c);
+    }
+    array_p pack(uint digits = 0)
+    {
+        if (digits)
+            for (size_t i = 0; i < rows * cols; ++i)
+                if (!(cells[i] = matrix_round(cells[i], digits)))
+                    return nullptr;
+        return array::build(rows, cols, item, this);
+    }
+};
+
+bool matrix_shape(array_r input, size_t &rows, size_t &cols)
+{
+    if (!input || input->type() != object::ID_array)
+    {
+        rt.type_error();
+        return false;
+    }
+    if (!input->is_matrix(&rows, &cols, false) || !rows || !cols || rows > 32 ||
+        cols > 32)
+    {
+        rt.dimension_error();
+        return false;
+    }
+    return true;
+}
+
+bool matrix_qr(numeric_matrix &r, numeric_matrix &q)
+{
+    if (!q.identity())
+        return false;
+    scoped_array<algebraic_g> v(r.rows);
+    if (!v)
+    {
+        rt.out_of_memory_error();
+        return false;
+    }
+    algebraic_g zero = integer::make(0), two = integer::make(2);
+    for (size_t k = 0; k < r.rows && k < r.cols; ++k)
+    {
+        if (program::interrupted())
+            return false;
+        algebraic_g norm = zero;
+        for (size_t i = k; i < r.rows; ++i)
+            norm = norm + r.at(i, k) * r.at(i, k);
+        if (!norm)
+            return false;
+        if (norm->is_zero(false))
+            continue;
+        norm = sqrt::run(norm);
+        if (!norm)
+            return false;
+        algebraic_g alpha = r.at(k, k)->is_negative(false) ? norm : -norm;
+        for (size_t i = k; i < r.rows; ++i)
+            v[i] = r.at(i, k);
+        v[k]               = v[k] - alpha;
+        algebraic_g square = zero;
+        for (size_t i = k; i < r.rows; ++i)
+            square = square + v[i] * v[i];
+        if (!square || square->is_zero(false))
+            return false;
+        for (size_t j = k; j < r.cols; ++j)
+        {
+            algebraic_g dot = zero;
+            for (size_t i = k; i < r.rows; ++i)
+                dot = dot + v[i] * r.at(i, j);
+            algebraic_g factor = two * dot / square;
+            for (size_t i = k; i < r.rows; ++i)
+                if (!(r.at(i, j) = r.at(i, j) - v[i] * factor))
+                    return false;
+        }
+        for (size_t i = 0; i < q.rows; ++i)
+        {
+            algebraic_g dot = zero;
+            for (size_t j = k; j < q.cols; ++j)
+                dot = dot + q.at(i, j) * v[j];
+            algebraic_g factor = two * dot / square;
+            for (size_t j = k; j < q.cols; ++j)
+                if (!(q.at(i, j) = q.at(i, j) - factor * v[j]))
+                    return false;
+        }
+        r.at(k, k) = alpha;
+        for (size_t i = k + 1; i < r.rows; ++i)
+            r.at(i, k) = zero;
+    }
+    return true;
+}
+
+object::result matrix_qr_command(bool lq)
+{
+    array_g input = array_p(rt.stack(0));
+    size_t  rows = 0, cols = 0;
+    if (!matrix_shape(input, rows, cols))
+        return object::ERROR;
+    settings::SaveHardwareFloatingPoint hardware(false);
+    settings::SaveNumericalResults      numerical(true);
+    uint                                digits = Settings.Precision();
+    if (digits > DB48X_MAXDIGITS - 8)
+    {
+        rt.precision_loss_error();
+        return object::ERROR;
+    }
+    settings::SavePrecision precision(digits + 8 < 12 ? 12 : digits + 8);
+    if (lq)
+    {
+        input = input->transpose();
+        if (!input)
+            return object::ERROR;
+        size_t temporary = rows;
+        rows             = cols;
+        cols             = temporary;
+    }
+    numeric_matrix r(rows, cols), q(rows, rows);
+    if (!r.valid() || !q.valid())
+    {
+        rt.out_of_memory_error();
+        return object::ERROR;
+    }
+    if (!r.load(input) || !matrix_qr(r, q))
+        return object::ERROR;
+    array_g qa = q.pack(digits), ra = r.pack(digits);
+    if (lq)
+    {
+        qa = qa ? qa->transpose() : nullptr;
+        ra = ra ? ra->transpose() : nullptr;
+        return qa && ra && rt.push(+qa) && rt.stack(1, ra) ? object::OK
+                                                           : object::ERROR;
+    }
+    return qa && ra && rt.push(+ra) && rt.stack(1, qa) ? object::OK
+                                                       : object::ERROR;
+}
+} // namespace
+
+COMMAND_BODY(MatrixQR)
+// ----------------------------------------------------------------------------
+//   Householder QR: A becomes Q R, with Q square and orthogonal
+// ----------------------------------------------------------------------------
+{
+    return matrix_qr_command(false);
+}
+
+COMMAND_BODY(LQ)
+// ----------------------------------------------------------------------------
+//   Householder LQ: A becomes L Q
+// ----------------------------------------------------------------------------
+{
+    return matrix_qr_command(true);
+}
+
+COMMAND_BODY(Cholesky)
+// ----------------------------------------------------------------------------
+//   Lower triangular factor of a real symmetric positive-definite matrix
+// ----------------------------------------------------------------------------
+{
+    array_g input = array_p(rt.stack(0));
+    size_t  rows = 0, cols = 0;
+    if (!matrix_shape(input, rows, cols))
+        return ERROR;
+    if (rows != cols)
+    {
+        rt.dimension_error();
+        return ERROR;
+    }
+    settings::SaveHardwareFloatingPoint hardware(false);
+    settings::SaveNumericalResults      numerical(true);
+    uint                                digits = Settings.Precision();
+    if (digits > DB48X_MAXDIGITS - 8)
+    {
+        rt.precision_loss_error();
+        return object::ERROR;
+    }
+    settings::SavePrecision precision(digits + 8 < 12 ? 12 : digits + 8);
+    numeric_matrix          a(rows, cols), l(rows, cols);
+    if (!a.valid() || !l.valid())
+    {
+        rt.out_of_memory_error();
+        return ERROR;
+    }
+    if (!a.load(input) || !l.identity())
+        return ERROR;
+    algebraic_g zero = integer::make(0);
+    for (size_t i = 0; i < rows; ++i)
+    {
+        for (size_t j = 0; j <= i; ++j)
+        {
+            if (program::interrupted())
+                return ERROR;
+            algebraic_g difference = a.at(i, j) - a.at(j, i);
+            if (!difference)
+                return ERROR;
+            if (!difference->is_zero(false))
+            {
+                rt.domain_error();
+                return ERROR;
+            }
+            algebraic_g value = a.at(i, j);
+            for (size_t k = 0; k < j; ++k)
+                value = value - l.at(i, k) * l.at(j, k);
+            if (!value)
+                return ERROR;
+            if (i == j)
+            {
+                if (value->is_negative(false) || value->is_zero(false))
+                {
+                    rt.domain_error();
+                    return ERROR;
+                }
+                value = sqrt::run(value);
+            }
+            else
+            {
+                value = value / l.at(j, j);
+            }
+            if (!(l.at(i, j) = value))
+                return ERROR;
+            if (i != j)
+                l.at(j, i) = zero;
+        }
+    }
+    array_g result = l.pack(digits);
+    return result && rt.top(result) ? OK : ERROR;
+}
+
+COMMAND_BODY(ToDiagonal)
+// ----------------------------------------------------------------------------
+//   Build a diagonal matrix from a vector
+// ----------------------------------------------------------------------------
+{
+    array_g input = array_p(rt.stack(0));
+    size_t  n     = 0;
+    if (!input)
+        return ERROR;
+    if (input->type() != ID_array)
+    {
+        rt.type_error();
+        return ERROR;
+    }
+    if (!input->is_vector(&n, false) || !n || n > 32)
+    {
+        rt.dimension_error();
+        return ERROR;
+    }
+    numeric_matrix result(n, n);
+    if (!result.valid())
+    {
+        rt.out_of_memory_error();
+        return ERROR;
+    }
+    if (!result.identity())
+        return ERROR;
+    size_t i = 0;
+    for (object_p item : *input)
+    {
+        algebraic_g value = item->as_algebraic();
+        if (!value)
+        {
+            rt.type_error();
+            return ERROR;
+        }
+        result.at(i, i) = value;
+        ++i;
+    }
+    array_g packed = result.pack();
+    return packed && rt.top(packed) ? OK : ERROR;
+}
+
+COMMAND_BODY(FromDiagonal)
+// ----------------------------------------------------------------------------
+//   Extract the main diagonal of a matrix
+// ----------------------------------------------------------------------------
+{
+    array_g input = array_p(rt.stack(0));
+    size_t  rows = 0, cols = 0;
+    if (!matrix_shape(input, rows, cols))
+        return ERROR;
+    size_t   n = rows < cols ? rows : cols;
+    scribble output;
+    size_t   r = 0;
+    for (object_p row : *input)
+    {
+        if (r >= n)
+            break;
+        list_g   line  = list_p(row);
+        object_g value = line->at(r++);
+        if (!output.append(value))
+            return ERROR;
+    }
+    array_g packed =
+        array_p(list::make(ID_array, output.scratch(), output.growth()));
+    return packed && rt.top(packed) ? OK : ERROR;
+}
+
+namespace
+{
+bool matrix_svd(numeric_matrix &b, numeric_matrix &v, algebraic_g *sigma)
+{
+    if (!v.identity())
+        return false;
+    algebraic_g zero = integer::make(0), one = integer::make(1),
+                two       = integer::make(2);
+    algebraic_g tolerance = decimal::make(1, -int(Settings.Precision() - 3));
+    bool        converged = false;
+    for (size_t sweep = 0; sweep < 128; ++sweep)
+    {
+        bool changed = false;
+        for (size_t p = 0; p < b.cols; ++p)
+        {
+            for (size_t q = p + 1; q < b.cols; ++q)
+            {
+                if (program::interrupted())
+                    return false;
+                algebraic_g alpha = zero, beta = zero, gamma = zero;
+                for (size_t i = 0; i < b.rows; ++i)
+                {
+                    alpha = alpha + b.at(i, p) * b.at(i, p);
+                    beta  = beta + b.at(i, q) * b.at(i, q);
+                    gamma = gamma + b.at(i, p) * b.at(i, q);
+                }
+                if (!alpha || !beta || !gamma)
+                    return false;
+                if (alpha->is_zero(false) || beta->is_zero(false))
+                    continue;
+                algebraic_g limit    = tolerance * sqrt::run(alpha * beta);
+                algebraic_g residual = abs::run(gamma) - limit;
+                if (!residual)
+                    return false;
+                if (residual->is_negative(false) || residual->is_zero(false))
+                    continue;
+                changed         = true;
+                algebraic_g tau = (beta - alpha) / (two * gamma);
+                algebraic_g t =
+                    one / (abs::run(tau) + sqrt::run(one + tau * tau));
+                if (!tau || !t)
+                    return false;
+                if (tau->is_negative(false))
+                    t = -t;
+                algebraic_g c = one / sqrt::run(one + t * t), s = c * t;
+                if (!c || !s)
+                    return false;
+                for (size_t i = 0; i < b.rows; ++i)
+                {
+                    algebraic_g x = b.at(i, p), y = b.at(i, q);
+                    b.at(i, p) = c * x - s * y;
+                    b.at(i, q) = s * x + c * y;
+                    if (!b.at(i, p) || !b.at(i, q))
+                        return false;
+                }
+                for (size_t i = 0; i < v.rows; ++i)
+                {
+                    algebraic_g x = v.at(i, p), y = v.at(i, q);
+                    v.at(i, p) = c * x - s * y;
+                    v.at(i, q) = s * x + c * y;
+                    if (!v.at(i, p) || !v.at(i, q))
+                        return false;
+                }
+            }
+        }
+        if (!changed)
+        {
+            converged = true;
+            break;
+        }
+    }
+    if (!converged)
+    {
+        rt.domain_error();
+        return false;
+    }
+    for (size_t j = 0; j < b.cols; ++j)
+    {
+        algebraic_g square = zero;
+        for (size_t i = 0; i < b.rows; ++i)
+            square = square + b.at(i, j) * b.at(i, j);
+        if (!(sigma[j] = sqrt::run(square)))
+            return false;
+    }
+    for (size_t p = 0; p < b.cols; ++p)
+    {
+        for (size_t q = p + 1; q < b.cols; ++q)
+        {
+            algebraic_g difference = sigma[q] - sigma[p];
+            if (!difference)
+                return false;
+            if (difference->is_negative(false) || difference->is_zero(false))
+                continue;
+            algebraic_g temporary = sigma[p];
+            sigma[p]              = sigma[q];
+            sigma[q]              = temporary;
+            for (size_t i = 0; i < b.rows; ++i)
+            {
+                temporary  = b.at(i, p);
+                b.at(i, p) = b.at(i, q);
+                b.at(i, q) = temporary;
+            }
+            for (size_t i = 0; i < v.rows; ++i)
+            {
+                temporary  = v.at(i, p);
+                v.at(i, p) = v.at(i, q);
+                v.at(i, q) = temporary;
+            }
+        }
+    }
+    // Normalize nonzero columns; complete the left basis at null singular
+    // values.
+    for (size_t j = 0; j < b.cols; ++j)
+    {
+        if (!sigma[j]->is_zero(false))
+        {
+            for (size_t i = 0; i < b.rows; ++i)
+                if (!(b.at(i, j) = b.at(i, j) / sigma[j]))
+                    return false;
+            continue;
+        }
+        bool found = false;
+        for (size_t axis = 0; axis < b.rows && !found; ++axis)
+        {
+            for (size_t i = 0; i < b.rows; ++i)
+                b.at(i, j) = i == axis ? one : zero;
+            for (size_t k = 0; k < j; ++k)
+            {
+                algebraic_g dot = zero;
+                for (size_t i = 0; i < b.rows; ++i)
+                    dot = dot + b.at(i, k) * b.at(i, j);
+                for (size_t i = 0; i < b.rows; ++i)
+                    b.at(i, j) = b.at(i, j) - dot * b.at(i, k);
+            }
+            algebraic_g square = zero;
+            for (size_t i = 0; i < b.rows; ++i)
+                square = square + b.at(i, j) * b.at(i, j);
+            algebraic_g residual = square - tolerance;
+            if (!residual)
+                return false;
+            if (residual->is_negative(false) || residual->is_zero(false))
+                continue;
+            algebraic_g length = sqrt::run(square);
+            for (size_t i = 0; i < b.rows; ++i)
+                b.at(i, j) = b.at(i, j) / length;
+            found = true;
+        }
+        if (!found)
+        {
+            rt.domain_error();
+            return false;
+        }
+    }
+    return true;
+}
+
+object_p singular_item(size_t, size_t, size_t row, size_t, void *data)
+{
+    return static_cast<algebraic_g *>(data)[row];
+}
+
+object::result matrix_svd_command(int mode)
+{
+    array_g input = array_p(rt.stack(0));
+    size_t  rows = 0, cols = 0;
+    if (!matrix_shape(input, rows, cols))
+        return object::ERROR;
+    settings::SaveHardwareFloatingPoint hardware(false);
+    settings::SaveNumericalResults      numerical(true);
+    uint                                digits = Settings.Precision();
+    if (digits > DB48X_MAXDIGITS - 8)
+    {
+        rt.precision_loss_error();
+        return object::ERROR;
+    }
+    settings::SavePrecision precision(digits + 8 < 12 ? 12 : digits + 8);
+    bool                    transposed = rows < cols;
+    if (transposed)
+    {
+        input = input->transpose();
+        if (!input)
+            return object::ERROR;
+        size_t temporary = rows;
+        rows             = cols;
+        cols             = temporary;
+    }
+    numeric_matrix            b(rows, cols), v(cols, cols);
+    scoped_array<algebraic_g> sigma(cols);
+    if (!b.valid() || !v.valid() || !sigma)
+    {
+        rt.out_of_memory_error();
+        return object::ERROR;
+    }
+    if (!b.load(input) || !matrix_svd(b, v, sigma.get()))
+        return object::ERROR;
+    if (mode == 2)
+    {
+        if (sigma[cols - 1]->is_zero(false))
+        {
+            rt.zero_divide_error();
+            return object::ERROR;
+        }
+        algebraic_g condition = sigma[0] / sigma[cols - 1];
+        condition             = matrix_round(condition, digits);
+        return condition && rt.top(condition) ? object::OK : object::ERROR;
+    }
+    for (size_t i = 0; i < cols; ++i)
+        if (!(sigma[i] = matrix_round(sigma[i], digits)))
+            return object::ERROR;
+    array_g singular = array::build(cols, 0, singular_item, sigma.get());
+    if (!singular)
+        return object::ERROR;
+    if (mode == 1)
+        return rt.top(singular) ? object::OK : object::ERROR;
+    array_g u = b.pack(digits), right = v.pack(digits);
+    if (transposed)
+    {
+        array_g temporary = u;
+        u                 = right;
+        right             = temporary;
+    }
+    if (!u || !right || !rt.push(+singular))
+        return object::ERROR;
+    if (!rt.push(+right))
+    {
+        rt.drop();
+        return object::ERROR;
+    }
+    return rt.stack(2, u) ? object::OK : object::ERROR;
+}
+} // namespace
+
+COMMAND_BODY(SVD)
+// ----------------------------------------------------------------------------
+//   Thin singular value decomposition: U singular-values V, A=U diag(s) V^T
+// ----------------------------------------------------------------------------
+{
+    return matrix_svd_command(0);
+}
+
+COMMAND_BODY(SVL)
+// ----------------------------------------------------------------------------
+//   Descending singular values of a real matrix
+// ----------------------------------------------------------------------------
+{
+    return matrix_svd_command(1);
+}
+
+COMMAND_BODY(CondNum)
+// ----------------------------------------------------------------------------
+//   Spectral condition number: largest divided by smallest singular value
+// ----------------------------------------------------------------------------
+{
+    return matrix_svd_command(2);
+}
+
+namespace
+{
+bool matrix_small(algebraic_r value, algebraic_r scale, algebraic_r tolerance)
+{
+    algebraic_g delta = abs::run(value) - tolerance * scale;
+    return delta && (delta->is_negative(false) || delta->is_zero(false));
+}
+
+bool matrix_schur(numeric_matrix &t, numeric_matrix &z)
+{
+    if (!z.identity())
+        return false;
+    const size_t n    = t.rows;
+    algebraic_g  zero = integer::make(0), one = integer::make(1),
+                two = integer::make(2), four = integer::make(4);
+    algebraic_g tolerance = decimal::make(1, -int(Settings.Precision() - 4));
+    algebraic_g scale     = zero;
+    for (size_t i = 0; i < n; ++i)
+        for (size_t j = 0; j < n; ++j)
+            scale = scale + abs::run(t.at(i, j));
+    if (!scale)
+        return false;
+    if (scale->is_zero(false))
+        return true;
+    size_t active = n;
+    for (size_t iteration = 0; active > 1 && iteration < 2000; ++iteration)
+    {
+        if (program::interrupted())
+            return false;
+        bool last = true;
+        for (size_t j = 0; j + 1 < active; ++j)
+            last = last && matrix_small(t.at(active - 1, j), scale, tolerance);
+        if (last)
+        {
+            for (size_t j = 0; j + 1 < active; ++j)
+                t.at(active - 1, j) = zero;
+            --active;
+            continue;
+        }
+        bool pair = true;
+        for (size_t i = active - 2; i < active; ++i)
+            for (size_t j = 0; j + 2 < active; ++j)
+                pair = pair && matrix_small(t.at(i, j), scale, tolerance);
+        if (pair)
+        {
+            algebraic_g a            = t.at(active - 2, active - 2),
+                        b            = t.at(active - 2, active - 1);
+            algebraic_g c            = t.at(active - 1, active - 2),
+                        d            = t.at(active - 1, active - 1);
+            algebraic_g discriminant = (a - d) * (a - d) + four * b * c;
+            if (!discriminant)
+                return false;
+            // Real eigenvalues must reduce to triangular one-by-one blocks.
+            if (discriminant->is_negative(false))
+            {
+                for (size_t i = active - 2; i < active; ++i)
+                    for (size_t j = 0; j + 2 < active; ++j)
+                        t.at(i, j) = zero;
+                active -= 2;
+                continue;
+            }
+        }
+        numeric_matrix r(active, active), q(active, active), work(n, n);
+        if (!r.valid() || !q.valid() || !work.valid())
+        {
+            rt.out_of_memory_error();
+            return false;
+        }
+        algebraic_g a            = t.at(active - 2, active - 2),
+                    b            = t.at(active - 2, active - 1);
+        algebraic_g c            = t.at(active - 1, active - 2),
+                    d            = t.at(active - 1, active - 1);
+        algebraic_g discriminant = (a - d) * (a - d) + four * b * c,
+                    shift        = (a + d) / two;
+        if (!discriminant || !shift)
+            return false;
+        if (!discriminant->is_negative(false))
+        {
+            algebraic_g root = sqrt::run(discriminant) / two;
+            algebraic_g left = shift - root, right = shift + root;
+            algebraic_g difference = abs::run(left - d) - abs::run(right - d);
+            if (!difference)
+                return false;
+            shift = difference->is_negative(false) ? left : right;
+        }
+        for (size_t i = 0; i < active; ++i)
+            for (size_t j = 0; j < active; ++j)
+                r.at(i, j) = i == j ? t.at(i, j) - shift : t.at(i, j);
+        if (!matrix_qr(r, q))
+            return false;
+        // T <- Q^T T Q, including its coupling to already deflated blocks.
+        for (size_t i = 0; i < n; ++i)
+        {
+            for (size_t j = 0; j < n; ++j)
+            {
+                algebraic_g value = zero;
+                if (j >= active)
+                    value = t.at(i, j);
+                else
+                    for (size_t k = 0; k < active; ++k)
+                        value = value + t.at(i, k) * q.at(k, j);
+                if (!(work.at(i, j) = value))
+                    return false;
+            }
+        }
+        for (size_t i = 0; i < n; ++i)
+        {
+            for (size_t j = 0; j < n; ++j)
+            {
+                algebraic_g value = zero;
+                if (i >= active)
+                    value = work.at(i, j);
+                else
+                    for (size_t k = 0; k < active; ++k)
+                        value = value + q.at(k, i) * work.at(k, j);
+                if (!(t.at(i, j) = value))
+                    return false;
+            }
+        }
+        for (size_t i = 0; i < n; ++i)
+        {
+            for (size_t j = 0; j < n; ++j)
+            {
+                algebraic_g value = zero;
+                if (j >= active)
+                    value = z.at(i, j);
+                else
+                    for (size_t k = 0; k < active; ++k)
+                        value = value + z.at(i, k) * q.at(k, j);
+                if (!(work.at(i, j) = value))
+                    return false;
+            }
+        }
+        for (size_t i = 0; i < n; ++i)
+            for (size_t j = 0; j < n; ++j)
+                z.at(i, j) = work.at(i, j);
+    }
+    if (active > 1)
+    {
+        rt.domain_error();
+        return false;
+    }
+    return true;
+}
+
+object::result matrix_schur_command(bool radius)
+{
+    array_g input = array_p(rt.stack(0));
+    size_t  rows = 0, cols = 0;
+    if (!matrix_shape(input, rows, cols))
+        return object::ERROR;
+    if (rows != cols)
+    {
+        rt.dimension_error();
+        return object::ERROR;
+    }
+    settings::SaveHardwareFloatingPoint hardware(false);
+    settings::SaveNumericalResults      numerical(true);
+    uint                                digits = Settings.Precision();
+    if (digits > DB48X_MAXDIGITS - 8)
+    {
+        rt.precision_loss_error();
+        return object::ERROR;
+    }
+    settings::SavePrecision precision(digits + 8 < 12 ? 12 : digits + 8);
+    numeric_matrix          t(rows, cols), z(rows, cols);
+    if (!t.valid() || !z.valid())
+    {
+        rt.out_of_memory_error();
+        return object::ERROR;
+    }
+    if (!t.load(input) || !matrix_schur(t, z))
+        return object::ERROR;
+    if (!radius)
+    {
+        array_g q = z.pack(digits), triangular = t.pack(digits);
+        return q && triangular && rt.push(+triangular) && rt.stack(1, q)
+                 ? object::OK
+                 : object::ERROR;
+    }
+    algebraic_g result = integer::make(0), two = integer::make(2),
+                four = integer::make(4);
+    for (size_t i = 0; i < rows; ++i)
+    {
+        algebraic_g candidate = abs::run(t.at(i, i));
+        if (i + 1 < rows && !t.at(i + 1, i)->is_zero(false))
+        {
+            algebraic_g a = t.at(i, i), b = t.at(i, i + 1), c = t.at(i + 1, i),
+                        d    = t.at(i + 1, i + 1);
+            algebraic_g disc = (a - d) * (a - d) + four * b * c;
+            if (!disc)
+                return object::ERROR;
+            if (disc->is_negative(false))
+            {
+                candidate = sqrt::run(abs::run(a * d - b * c));
+            }
+            else
+            {
+                algebraic_g root  = sqrt::run(disc),
+                            x     = abs::run((a + d + root) / two),
+                            y     = abs::run((a + d - root) / two);
+                algebraic_g delta = x - y;
+                if (!delta)
+                    return object::ERROR;
+                candidate = delta->is_negative(false) ? y : x;
+            }
+            ++i;
+        }
+        algebraic_g delta = candidate - result;
+        if (!delta)
+            return object::ERROR;
+        if (!delta->is_negative(false))
+            result = candidate;
+    }
+    result = matrix_round(result, digits);
+    return result && rt.top(result) ? object::OK : object::ERROR;
+}
