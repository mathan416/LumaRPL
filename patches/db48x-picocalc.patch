+FUNCTION_BODY(Termial)
+// ----------------------------------------------------------------------------
+//   The triangular sum 0 + 1 + ... + n, using exact integer arithmetic.
+// ----------------------------------------------------------------------------
+{
+    if (!x)
+        return nullptr;
+    if (x->is_symbolic())
+        return symbolic(ID_Termial, x);
+    if (!(x->is_real() || x->is_integer() || x->is_fraction()))
+    {
+        rt.type_error();
+        return nullptr;
+    }
+    settings::SaveHardwareFloatingPoint hardware(false);
+    settings::SaveNumericalResults exact(false);
+    algebraic_g value = x;
+    if (value->is_based())
+    {
+        id target = value->is_bignum() ? ID_bignum : ID_integer;
+        object_g unbased = rt.clone(value);
+        if (!unbased)
+            return nullptr;
+        ASSERT(leb128size(value->type()) == leb128size(target));
+        byte *data = (byte *) +unbased;
+        leb128(data, target);
+        value = algebraic_p(+unbased);
+    }
+    algebraic_g n = IntPart::run(value);
+    int cmp = 0;
+    if (!n || !comparison::compare(&cmp, n, value))
+        return nullptr;
+    if (cmp || n->is_negative(false))
+    {
+        rt.domain_error();
+        return nullptr;
+    }
+    if (!algebraic::to_integer(n) || !n || !n->is_integer())
+    {
+        if (!rt.error())
+            rt.domain_error();
+        return nullptr;
+    }
+    algebraic_g one = integer::make(1), two = integer::make(2);
+    return (n * (n + one)) / two;
+}
+
