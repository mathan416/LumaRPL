+struct modular_matrix
+{
+    uint32_t       *data;
+    size_t          columns;
+    static object_p item(size_t, size_t, size_t r, size_t c, void *opaque)
+    {
+        auto &matrix = *static_cast<modular_matrix *>(opaque);
+        return integer::make(matrix.data[r * matrix.columns + c]);
+    }
+};
