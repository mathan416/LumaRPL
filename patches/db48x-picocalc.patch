+    {
+        algebraic_g parameters[2] = { args[0] / two, args[1] / two };
+        return GammaP::evaluate(object::ID_GammaP, parameters, 2);
+    }
+    algebraic_g scaled        = args[2] * args[0];
+    algebraic_g parameters[3] = { scaled / (scaled + args[1]),
+                                  args[1] / two,
+                                  args[2] / two };
+    return BetaI::evaluate(object::ID_BetaI, parameters, 3);
+}
+
+NFUNCTION_BODY(Normal)
+// ----------------------------------------------------------------------------
+//   Normal lower-tail probability: mean variance x
+// ----------------------------------------------------------------------------
+{
+    return distribution_cdf(ID_Normal, args);
+}
+
+NFUNCTION_BODY(Student)
+// ----------------------------------------------------------------------------
+//   Student lower-tail probability: degrees-of-freedom x
+// ----------------------------------------------------------------------------
+{
+    return distribution_cdf(ID_Student, args);
+}
+
+NFUNCTION_BODY(ChiSquare)
+// ----------------------------------------------------------------------------
+//   Chi-square lower-tail probability: degrees-of-freedom x
+// ----------------------------------------------------------------------------
+{
+    return distribution_cdf(ID_ChiSquare, args);
+}
+
+NFUNCTION_BODY(FDistribution)
+// ----------------------------------------------------------------------------
+//   Fisher lower-tail probability: numerator-df denominator-df x
+// ----------------------------------------------------------------------------
+{
+    return distribution_cdf(ID_FDistribution, args);
+}
+
+static algebraic_p distribution_tail(object::id command, algebraic_g *args)
+// ----------------------------------------------------------------------------
+//   Evaluate upper tails directly so inverse probabilities do not lose digits
+// ----------------------------------------------------------------------------
+{
+    if (command == object::ID_Normal)
+        return UTPN::evaluate(object::ID_UTPN, args, 3);
+    if (command == object::ID_Student)
+        return UTPT::evaluate(object::ID_UTPT, args, 2);
+    algebraic_g one = integer::make(1), two = integer::make(2);
+    if (args[1]->is_negative(false) || args[1]->is_zero(false) ||
+        (command == object::ID_FDistribution &&
+         (args[2]->is_negative(false) || args[2]->is_zero(false))))
+    {
+        rt.domain_error();
+        return nullptr;
+    }
+    if (args[0]->is_negative(false) || args[0]->is_zero(false))
+        return one;
+    if (command == object::ID_ChiSquare)
+    {
+        algebraic_g a = args[1] / two, x = args[0] / two;
+        algebraic_g threshold = x - a - one;
+        if (!threshold)
+            return nullptr;
+        if (!threshold->is_negative(false))
+        {
+            algebraic_g loggamma = lgamma::run(a);
+            return loggamma ? gamma_q_fraction(a, x, loggamma) : nullptr;
+        }
+        algebraic_g parameters[2] = { x, a };
+        algebraic_g lower = GammaP::evaluate(object::ID_GammaP, parameters, 2);
+        return lower ? one - lower : nullptr;
+    }
+    algebraic_g scaled        = args[2] * args[0];
+    algebraic_g parameters[3] = { args[1] / (scaled + args[1]),
+                                  args[2] / two,
+                                  args[1] / two };
+    return BetaI::evaluate(object::ID_BetaI, parameters, 3);
+}
+
+static algebraic_p distribution_quantile(object::id   command,
+                                         algebraic_g *args,
+                                         size_t       count)
+// ----------------------------------------------------------------------------
+//   Bracket then bisect a finite quantile at the selected decimal precision
+// ----------------------------------------------------------------------------
+{
+    object::id inverse = command == object::ID_Normal  ? object::ID_InvNormal
+                       : command == object::ID_Student ? object::ID_InvStudent
+                       : command == object::ID_ChiSquare
+                           ? object::ID_InvChiSquare
+                           : object::ID_InvFDistribution;
+    for (uint i = 0; i < count; ++i)
+        if (args[i]->is_symbolic())
+            return expression::make(inverse,
+                                    args,
+                                    count,
+                                    object::ID_expression,
+                                    true);
+    for (uint i = 0; i < count; ++i)
+        if (!args[i]->is_real())
+        {
+            rt.type_error();
+            return nullptr;
+        }
+    settings::SaveHardwareFloatingPoint hardware(false);
+    settings::SaveNumericalResults      numerical(true);
+    uint                                digits = Settings.Precision();
+    if (digits > DB48X_MAXDIGITS - 8)
+    {
+        rt.precision_loss_error();
+        return nullptr;
+    }
+    settings::SavePrecision precision(digits + 8);
+    algebraic_g             zero = integer::make(0), one = integer::make(1);
+    algebraic_g             two = integer::make(2), probability = args[0];
+    if (!probability->is_real() || probability->is_negative(false) ||
+        probability->is_zero(false) || !(one - probability) ||
+        (one - probability)->is_negative(false) ||
+        (one - probability)->is_zero(false))
+    {
+        rt.domain_error();
+        return nullptr;
+    }
+    algebraic_g centered = probability - algebraic_g(decimal::make(5, -1));
+    if (!centered)
+        return nullptr;
+    bool upper = !centered->is_negative(false) && !centered->is_zero(false);
+    if (upper)
+        probability = one - probability;
+    algebraic_g parameters[3]  = { zero, args[1], count == 3 ? args[2] : zero };
+    auto        probability_at = [&]() -> algebraic_p
+    {
+        return upper ? distribution_tail(command, parameters)
+                     : distribution_cdf(command, parameters);
+    };
+    algebraic_g low =
+        command == object::ID_Normal || command == object::ID_Student ? -one
+                                                                      : zero;
+    algebraic_g high      = one, value;
+    bool        bracketed = false;
+    for (uint step = 0; step < 4096; ++step)
+    {
+        if (program::interrupted())
+            return nullptr;
+        parameters[0] = low;
+        value         = probability_at();
+        if (!value)
+            return nullptr;
+        algebraic_g delta = upper ? probability - value : value - probability;
+        if (!delta)
+            return nullptr;
+        if (delta->is_negative(false) || delta->is_zero(false))
+        {
+            parameters[0] = high;
+            value         = probability_at();
+            delta = value ? (upper ? probability - value : value - probability)
+                          : nullptr;
+            if (!delta)
+                return nullptr;
+            if (!delta->is_negative(false))
+            {
+                bracketed = true;
+                break;
+            }
+            high = high * two;
+        }
+        else
+        {
+            low = low * two;
+        }
+    }
+    if (!bracketed)
+    {
+        rt.domain_error();
+        return nullptr;
+    }
+    algebraic_g tolerance = decimal::make(1, -int(digits + 2));
+    for (uint step = 0; step < 4 * digits + 64; ++step)
+    {
+        if (program::interrupted())
+            return nullptr;
+        algebraic_g middle = (low + high) / two;
+        parameters[0]      = middle;
+        value              = probability_at();
+        if (!value)
+            return nullptr;
+        algebraic_g delta = upper ? probability - value : value - probability;
+        if (!delta)
+            return nullptr;
+        if (delta->is_zero(false))
+            return middle;
+        if (delta->is_negative(false))
+            low = middle;
+        else
+            high = middle;
+        algebraic_g width     = high - low;
+        algebraic_g bound     = tolerance * (one + abs::run(middle));
+        algebraic_g remaining = width - bound;
+        if (!remaining)
+            return nullptr;
+        if (remaining->is_negative(false))
+            return (low + high) / two;
+    }
+    rt.domain_error();
+    return nullptr;
+}
+
+NFUNCTION_BODY(InvNormal)
+// ----------------------------------------------------------------------------
+//   Normal quantile: mean variance probability
+// ----------------------------------------------------------------------------
+{
+    return distribution_quantile(ID_Normal, args, 3);
+}
+
+NFUNCTION_BODY(InvStudent)
+// ----------------------------------------------------------------------------
+//   Student quantile: degrees-of-freedom probability
+// ----------------------------------------------------------------------------
+{
+    return distribution_quantile(ID_Student, args, 2);
+}
+
+NFUNCTION_BODY(InvChiSquare)
+// ----------------------------------------------------------------------------
+//   Chi-square quantile: degrees-of-freedom probability
+// ----------------------------------------------------------------------------
+{
+    return distribution_quantile(ID_ChiSquare, args, 2);
+}
+
+NFUNCTION_BODY(InvFDistribution)
+// ----------------------------------------------------------------------------
+//   Fisher quantile: numerator-df denominator-df probability
+// ----------------------------------------------------------------------------
+{
+    return distribution_quantile(ID_FDistribution, args, 3);
+}
