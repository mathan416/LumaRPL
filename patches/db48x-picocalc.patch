+COMMAND_BODY(Find)
+// ----------------------------------------------------------------------------
+//   Return the first one-based list/vector element index, or zero if absent
+// ----------------------------------------------------------------------------
+{
+    object_g target=rt.stack(0),container=rt.stack(1);
+    if(!target||!container)return ERROR;
+    if(container->type()!=ID_list && container->type()!=ID_array)
+    {rt.type_error();return ERROR;}
+    list_g sequence=list_p(+container);size_t index=0,found=0;
+    for(object_p item:*sequence)
+    {
+        if(program::interrupted())return ERROR;
+        ++index;
+        if(item->is_same_as(target)){found=index;break;}
+    }
+    integer_g result=integer::make(found);
+    return result && rt.drop() && rt.top(result)?OK:ERROR;
+}
