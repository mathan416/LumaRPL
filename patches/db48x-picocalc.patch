diff --git a/src/scoped_array.h b/src/scoped_array.h
new file mode 100644
index 0000000000000000000000000000000000000000..fbd86550cd8a979072483f3f60b3ed5c4332e62a
--- /dev/null
+++ b/src/scoped_array.h
@@ -0,0 +1,35 @@
+#ifndef DB48X_SCOPED_ARRAY_H
+#define DB48X_SCOPED_ARRAY_H
+// Fallible scratch storage outside the C stack. Construct GC roots in order
+// and destroy them in reverse order, just like an automatic array.
+#include <cstdlib>
+#include <new>
+#include <stdint.h>
+template<class T> class scoped_array
+{
+    T *data=nullptr;
+    size_t count=0;
+public:
+    explicit scoped_array(size_t n):count(n)
+    {
+        if(n && n<=SIZE_MAX/sizeof(T))
+            data=static_cast<T *>(std::malloc(n*sizeof(T)));
+        if(data)
+            for(size_t i=0;i<n;++i) ::new(static_cast<void *>(data+i)) T();
+    }
+    ~scoped_array()
+    {
+        if(data)
+        {
+            for(size_t i=count;i;--i) data[i-1].~T();
+            std::free(data);
+        }
+    }
+    scoped_array(const scoped_array &)=delete;
+    scoped_array &operator=(const scoped_array &)=delete;
+    bool operator!() const {return count&&!data;}
+    T *get() {return data;}
+    const T *get() const {return data;}
+    T &operator[](size_t i) {return data[i];}
+};
+#endif
